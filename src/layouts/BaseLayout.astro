---
// Shared page shell: <head> metadata, header, footer, and the tiny
// vanilla-JS scroll fade-in script. Every page wraps its content in
// this layout so meta tags and nav stay consistent site-wide.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConstructionBanner from '../components/ConstructionBanner.astro';
import WatermarkOverlay from '../components/WatermarkOverlay.astro';
import { SITE, SITE_UNDER_CONSTRUCTION } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Site-relative path to the preview image. Defaults to the brand
      visual; product pages pass the book's own cover. */
  image?: string;
  /** Keep the page out of search results (a title not yet on sale). */
  noindex?: boolean;
  /** Re-colours the whole page (header and footer too) — see the "earth"
      theme in BookProductLayout.astro. */
  theme?: "earth";
}
const { title, description, image = '/about/brand-hero.jpg', noindex = false, theme } = Astro.props;

// og:image must be absolute — Pinterest, Facebook and iMessage all reject
// a relative path and fall back to no preview at all, which is what this
// site was doing until now.
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {SITE.imprintName}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Pinterest domain claim. Pinterest fetches the root URL and looks
         for this tag, so it lives in the shared layout rather than on one
         page; the three printed-QR landing pages are standalone and do
         not carry it, which is fine — claiming only reads the root.
         Keep it: removing it un-claims the domain, which would drop the
         logicmanse.ca attribution and analytics from every pin. -->
    <meta name="p:domain_verify" content="d396c13ff247ecc33f6f3a87a6040f57" />

    <!-- Open Graph / social preview -->
    <meta property="og:title" content={`${title} | ${SITE.imprintName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Fonts: Merriweather (serif headers) + Inter (sans body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Runs before first paint so the scroll-driven hero/showcase layout
         is in place immediately. Visitors who ask for reduced motion never
         get the "motion" class and see the plain static layout instead. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body class:list={[theme === "earth" && "theme-earth"]}>
    <div id="scroll-progress" aria-hidden="true"></div>
    {SITE_UNDER_CONSTRUCTION && <ConstructionBanner />}
    {SITE_UNDER_CONSTRUCTION && <WatermarkOverlay />}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Reveals any element with class "fade-in-up" as it scrolls into
      // view. Plain IntersectionObserver — no animation library, no
      // layout shift, and it degrades gracefully (content is simply
      // visible immediately) if JS fails to load.
      const items = document.querySelectorAll<HTMLElement>('.fade-in-up');

      // Children of a [data-stagger] container reveal one after another.
      // The delay is cleared once the reveal has played so it can't
      // slow down hover transitions on the same element later.
      document.querySelectorAll('[data-stagger]').forEach((group) => {
        group.querySelectorAll<HTMLElement>('.fade-in-up').forEach((el, i) => {
          el.style.transitionDelay = `${i * 90}ms`;
          el.dataset.delay = String(i * 90);
        });
      });

      const reveal = (el: HTMLElement) => {
        el.classList.add('is-visible');
        setTimeout(() => (el.style.transitionDelay = ''), 800 + Number(el.dataset.delay ?? 0));
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );

        items.forEach((el) => observer.observe(el));

        // Safety net: anything already on screen (or above it, e.g. after
        // a reload mid-page) that never crossed the threshold is shown
        // after a beat. Elements further down are deliberately left for
        // the observer, so they still animate in as you scroll.
        setTimeout(() => {
          items.forEach((el) => {
            if (el.getBoundingClientRect().top < window.innerHeight) reveal(el);
          });
        }, 1200);
      } else {
        // No IntersectionObserver support — just show everything.
        items.forEach((el) => el.classList.add('is-visible'));
      }

      // ---- Scroll progress bar + gentle parallax --------------------
      // One passive scroll listener, batched through requestAnimationFrame.
      // [data-parallax="0.08"] elements drift against the scroll by that
      // fraction of their distance from the viewport centre.
      if (document.documentElement.classList.contains('motion')) {
        const bar = document.getElementById('scroll-progress');
        const drifters = document.querySelectorAll<HTMLElement>('[data-parallax]');
        let queued = false;

        const frame = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar?.style.setProperty('--sp', String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
          const mid = window.innerHeight / 2;
          drifters.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > window.innerHeight + 200) return;
            const speed = Number(el.dataset.parallax);
            el.style.transform = `translate3d(0, ${((r.top + r.height / 2 - mid) * -speed).toFixed(1)}px, 0)`;
          });
        };
        const queue = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(frame);
          }
        };
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue);
        frame();
      }
    </script>
  </body>
</html>
