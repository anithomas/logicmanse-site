---
// Shared product page for one title — the page a visitor who has NOT
// bought the book lands on, reached from /books/ or the homepage.
//
// It uses the site's own BaseLayout (header, nav, footer) precisely
// because it is FOR a visitor browsing the site, who needs to be able to
// get elsewhere. That is the opposite of the QR-code pages, which are
// deliberately standalone: a reader arriving there came from a printed
// book with one thing to do, and the site's nav would only distract.
//
// The free companion is described here as something a copy includes, and
// linked only as "after you buy" — the giveaway itself lives behind the
// book's own printed QR URL, so it stays a reason to buy rather than a
// way to skip buying.
import BaseLayout from './BaseLayout.astro';
import BuyButtons from '../components/BuyButtons.astro';
import CTAButton from '../components/CTAButton.astro';
import PromoVideo from '../components/PromoVideo.astro';
import { BOOK_LINKS, ETSY_SHOP_URL } from '../data/site';
import type { Book } from '../data/books';

interface Props {
  book: Book;
}
const { book } = Astro.props;

// Review links, one line, only for stores this title is actually on.
// Same three links, same wording, as the post-purchase Reach email's
// P.S. — a reader landing here from that email should see the identical
// ask, not a paraphrase of it. Amazon links go straight to the book's
// own /dp/ page rather than a review-specific URL: "scroll to Customer
// reviews and tap Write a customer review" from there is the same
// instruction the email gives, and it is one click either way.
const { etsy, amazon } = BOOK_LINKS[book.key];
const offer = book.companionOffer;
const reviewLinks = (
  [
    amazon.com && { label: 'Amazon', href: amazon.com },
    amazon.ca && { label: 'Amazon.ca', href: amazon.ca },
    etsy && { label: 'Etsy (via your Purchases page)', href: ETSY_SHOP_URL },
  ] as const
).filter((l): l is { label: string; href: string } => Boolean(l));
---

<BaseLayout
  title={book.title}
  description={book.tagline}
  image={book.cover || undefined}
  noindex={book.unreleased}
  theme={book.theme}
>
  <!-- ============ HERO: cover + the two storefronts ============ -->
  <section class="bg-navy text-white">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20 grid md:grid-cols-2 gap-10 items-center">
      <div class="fade-in-up order-2 md:order-1">
        <span
          class="inline-block bg-white/10 text-white/80 text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full mb-4"
        >
          {book.category}
        </span>
        <h1 class="font-serif font-bold text-3xl md:text-4xl leading-tight mb-4 text-white">{book.title}</h1>
        <p class="text-lg text-white/80 leading-relaxed mb-4">{book.tagline}</p>
        <p class="text-xs uppercase tracking-widest text-white/50 mb-8">{book.specs}</p>

        <BuyButtons bookKey={book.key} />

        <p class="text-sm text-white/60 mt-5 leading-relaxed">
          Every copy includes <strong class="text-white/90">{book.companion.name}</strong>, free —
          {book.companion.blurb} The book tells you where to get it.
        </p>
      </div>

      <div class="fade-in-up order-1 md:order-2 flex justify-center">
        {book.cover ? (
          <img
            src={book.cover}
            alt={book.coverAlt}
            class="rounded-lg shadow-2xl w-auto max-h-[26rem]"
          />
        ) : (
          <div
            class="rounded-lg shadow-2xl w-64 aspect-[1082/1400] border border-white/20 bg-white/5 flex items-center justify-center text-center p-6"
          >
            <p class="font-serif font-bold text-white/70 leading-snug">Cover coming soon</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ============ WHAT'S INSIDE ============ -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-20 grid md:grid-cols-2 gap-12">
      <div class="fade-in-up">
        <h2 class="text-2xl font-serif font-bold text-navy mb-6">What's inside</h2>
        <ul class="space-y-4">
          {book.inside.map((item) => (
            <li class="flex gap-3 text-slate-600 leading-relaxed">
              <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-forest"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fade-in-up space-y-8">
        {/* The video and the interior still show the same thing — the
            slideshow opens on a page from the book — so only one of them
            goes here, and the still becomes the video's poster rather
            than a second copy beneath it. */}
        {book.video ? (
          <PromoVideo
            src={book.video}
            poster={book.videoPoster ?? book.cover}
            label={`A short look inside ${book.title}`}
            class="rounded-lg shadow-lg"
          />
        ) : (
          book.interior && (
            <img
              src={book.interior}
              alt={book.interiorAlt}
              class="rounded-lg shadow-lg w-full h-auto"
            />
          )
        )}
        {book.story && (
          <blockquote class="border-l-4 border-forest pl-5">
            <p class="font-serif font-bold text-navy text-lg mb-2">{book.story.quote}</p>
            <p class="text-slate-600 leading-relaxed text-sm">{book.story.body}</p>
          </blockquote>
        )}
      </div>
    </div>
  </section>

  <!-- ============ FREE COMPANION: one button (a sign-up form or a
       direct download) with a short write-up around it. See companionOffer
       in books.ts. ============ -->
  {offer && (
    <section id="companion" class="bg-slate-50 border-t border-slate-200 scroll-mt-20">
      <div class="max-w-3xl mx-auto px-6 py-16 md:py-20">
        <p class="fade-in-up text-xs font-bold uppercase tracking-widest companion-eyebrow text-center mb-3">
          Already own the book?
        </p>
        <h2 class="fade-in-up text-2xl md:text-3xl font-serif font-bold text-navy text-center mb-4">
          Claim your free companion
        </h2>
        <p class="fade-in-up text-slate-600 leading-relaxed text-center mb-8">
          {book.companion.blurb}
        </p>

        <ul class="fade-in-up space-y-3 mb-8">
          {offer.contents.map((item) => (
            <li class="flex gap-3 text-slate-600 leading-relaxed">
              <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-forest"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        {offer.cta.href && (
          <div class="fade-in-up companion-box border border-slate-200 rounded-xl p-6 text-center mb-10">
            <a
              href={offer.cta.href}
              download={offer.cta.download}
              rel={offer.cta.download ? undefined : 'noopener'}
              class="inline-block rounded-lg px-6 py-3.5 bg-forest hover:bg-forest-light text-white font-bold transition-colors duration-150"
            >
              {offer.cta.label}
            </a>
            <p class="text-xs text-slate-400 mt-3 break-all">{offer.cta.note}</p>
          </div>
        )}

        <h3 class="fade-in-up font-serif font-bold text-navy text-lg mb-4">How to use it</h3>
        <ol class="fade-in-up space-y-3">
          {offer.steps.map((step, i) => (
            <li class="flex gap-3 text-slate-600 leading-relaxed">
              <span class="shrink-0 w-6 h-6 rounded-full step-dot text-white text-sm font-bold flex items-center justify-center">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- ============ CLOSING: buy, then the bonus ============ -->
  <section class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-3xl mx-auto px-6 py-16 md:py-20 text-center">
      <h2 class="fade-in-up text-2xl md:text-3xl font-serif font-bold text-navy mb-3">
        Get {book.title}
      </h2>
      <p class="fade-in-up text-slate-600 mb-8">
        {book.unreleased
          ? 'This book is still being finished. Both stores will be linked here the day it goes on sale.'
          : 'Print it at home today, or have the paperback delivered. Same book either way.'}
      </p>
      <div class="fade-in-up max-w-xl mx-auto text-left">
        <BuyButtons bookKey={book.key} />
      </div>

      <p class="fade-in-up text-sm text-slate-500 mt-8">
        Already own it? <a href={book.qrHref} class="text-forest font-semibold hover:underline"
          >Claim your free {book.companion.name} &rarr;</a
        >
      </p>

      {reviewLinks.length > 0 && (
        <p class="fade-in-up text-sm text-slate-500 mt-2">
          Already read it? A quick honest review helps more than almost anything else:{' '}
          {reviewLinks.map((link, i) => (
            <>
              {i > 0 && ' · '}
              <a href={link.href} class="text-forest font-semibold hover:underline">{link.label}</a>
            </>
          ))}
        </p>
      )}
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 py-14 text-center">
      <div class="fade-in-up">
        <CTAButton href="/books/">See All Books</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Companion section pieces — plain defaults, recoloured by a theme below. */
  .companion-eyebrow { color: #1f6f4a; }
  .companion-box { background: #fff; }
  .step-dot { background: #1f6f4a; }

  /* ---- Per-title themes (see BookTheme in books.ts) ----------------------
     Each theme is a set of variables taken from that book's own cover and
     QR landing page; one shared block of rules then re-colours the
     utilities this layout, the header, the footer, BuyButtons and CTAButton
     already use, so no markup changes. The class goes on <body> so the
     header and footer follow.
       --t-hero      hero band and header       --t-foot   footer
       --t-ink       headings                   --t-body   running text
       --t-muted     small print               --t-bg1    "white" sections
       --t-bg2       alternate sections         --t-line   borders
       --t-btn       buttons (+ --t-btn-h)      --t-accent links, bullets, bar
       --t-dot       eyebrow, step numbers, header wordmark
       --t-box       companion box border       --t-font   type, if not the site's */
  .theme-pink {
    --t-hero: #b32a54; --t-foot: #8f1f42; --t-ink: #a8264c; --t-body: #444;
    --t-muted: #777; --t-bg1: #fff; --t-bg2: #fdeff3; --t-line: #f3cdd8;
    --t-btn: #1f6f4a; --t-btn-h: #2c8a5d; --t-accent: #c8325a; --t-dot: #c8325a;
    --t-box: #e67896; --t-mark: #ffd3e0;
  }
  .theme-forest {
    --t-hero: #1f3b36; --t-foot: #142825; --t-ink: #1f3b36; --t-body: #333;
    --t-muted: #666; --t-bg1: #f4f1e6; --t-bg2: #ebe6d3; --t-line: #ddd6bf;
    --t-btn: #9a7a3f; --t-btn-h: #7f6330; --t-accent: #2b5d63; --t-dot: #b08d4f;
    --t-box: #2b5d63;
  }
  .theme-clay {
    --t-hero: #3a2f2a; --t-foot: #2a211d; --t-ink: #3a2f2a; --t-body: #3a2f2a;
    --t-muted: #7a6a60; --t-bg1: #f7f0e3; --t-bg2: #efe2cc; --t-line: #d8c3a0;
    --t-btn: #c1624f; --t-btn-h: #a84f3e; --t-accent: #c1624f; --t-dot: #c1624f;
    --t-box: #d8c3a0; --t-font: Georgia, 'Times New Roman', serif;
  }
  /* Renovation book: the palette and type of its own landing-page file. */
  .theme-earth {
    --t-hero: #241f1b; --t-foot: #17130f; --t-ink: #3a302b; --t-body: #3a302b;
    --t-muted: #6a5a52; --t-bg1: #f6eedf; --t-bg2: #efe3ce; --t-line: #d8c9ae;
    --t-btn: #c2624f; --t-btn-h: #a94f3d; --t-accent: #c2624f; --t-dot: #ad8a4e;
    --t-box: #6a5a52; --t-font: Georgia, 'Times New Roman', serif;
  }

  .themed { font-family: var(--t-font, inherit); }
  .themed .font-serif { font-family: var(--t-font, Merriweather, Georgia, serif); }
  .themed .bg-navy { background: var(--t-hero); }
  .themed .bg-navy-dark { background: var(--t-foot); }
  .themed .text-navy { color: var(--t-ink); }
  .themed .bg-white { background: var(--t-bg1); }
  .themed .bg-slate-50 { background: var(--t-bg2); }
  .themed .border-slate-200,
  .themed .border-slate-300 { border-color: var(--t-line); }
  .themed .text-slate-600 { color: var(--t-body); }
  .themed .text-slate-500,
  .themed .text-slate-400 { color: var(--t-muted); }
  .themed .bg-forest { background: var(--t-btn); }
  .themed .hover\:bg-forest-light:hover { background: var(--t-btn-h); }
  .themed .text-forest { color: var(--t-accent); }
  .themed .border-forest { border-color: var(--t-accent); }
  .themed .text-forest-light,
  .themed .hover\:text-forest-light:hover { color: var(--t-mark, var(--t-dot)); }
  .themed .companion-eyebrow { color: var(--t-dot); font-style: italic; }
  .themed .companion-box { background: #fff; border-color: var(--t-box); }
  .themed .step-dot { background: var(--t-dot); }
</style>
