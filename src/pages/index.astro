---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import { SITE } from '../data/site';
import { SHELF, coverThumb } from '../data/books';
import PromoVideo from '../components/PromoVideo.astro';

// Order is deliberate, not alphabetical or by launch date (owner,
// 2026-09-30): coloring and cookbooks lead, log books sit third — log
// books are comparatively low-content, so they shouldn't be the first
// thing a new visitor sees this publisher as. Keep this order in sync
// with CATEGORY_ORDER in src/pages/books.astro, the other fixed-order
// category list on the site.
const CATEGORIES = [
  {
    name: 'Coloring & Activity Books',
    description: 'Mazes, word searches, and coloring pages kids actually finish — not just start.',
  },
  {
    name: 'Cookbooks',
    description: 'Recipes organized around how you actually cook, not how a magazine lays out a page.',
  },
  {
    name: 'Log Books & Record Books',
    description: 'Built around a real full year of use, not a generic 4-property template.',
  },
  {
    name: 'Journals',
    description: 'Simple, guided pages that get used past the first week.',
  },
];

// Featured cards read from the shared book records and link to each
// title's PRODUCT page — never to its printed QR URL, which is for
// readers who already own the book (see src/data/books.ts).
---

<BaseLayout
  title="Coloring Books, Log Books, Journals & Cookbooks"
  description="LogicManse Publications publishes coloring books, log books, journals, and cookbooks designed around how you actually use them."
>
  <!-- ============ HERO ============ -->
  <!-- Changed 2026-09-27: the previous hero was a full-bleed photo of
       Leia's backyard illustration — striking when she was the only real
       title, but wrong now that the shelf spans coloring books, log
       books and a cookbook: one children's-book image as the site's
       entire first impression misrepresents the catalog and, per the
       owner, "kills the site visual." Replaced with a plain navy hero
       (the site's own brand, not any one book's palette) and a fanned
       spread of every real cover in SHELF — the actual claim "Real
       Books, Not Mockups" made visually, up front, for the whole
       catalog rather than one title. Scales automatically as titles are
       added or removed; no per-book styling to maintain. -->
  <section class="hero-plain bg-navy text-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div>
        <p class="rise text-sm font-semibold uppercase tracking-widest mb-4" style="--i:0; color:#8fd1ae">
          LogicManse Publications
        </p>
        <h1 class="font-serif font-bold text-4xl md:text-6xl leading-tight mb-6 text-white">
          {SITE.tagline.split(' ').map((word, i) => (
            <Fragment><span class="rise" style={`--i:${i + 1}`}>{word}</span>{' '}</Fragment>
          ))}
        </h1>
        <p class="rise text-lg md:text-xl text-white/85 mb-9 leading-relaxed" style="--i:7">
          {SITE.subTagline}
        </p>
        <div class="rise flex flex-wrap items-center gap-4 mb-2" style="--i:8">
          <CTAButton href="/books/">Browse Our Books</CTAButton>
          <a
            href="/contact/"
            class="inline-block border border-white/40 hover:border-white text-white font-semibold px-6 py-3 rounded-md transition-colors"
          >
            Get in Touch
          </a>
        </div>
      </div>

      <div class="hero-shelf" style={`--n:${SHELF.length}`}>
        {SHELF.map((book, i) => (
          <a href={book.productHref} class="hero-shelf-cover" style={`--i:${i}`}>
            <img src={coverThumb(book)} alt={book.coverAlt} loading={i === 0 ? 'eager' : 'lazy'} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CREDIBILITY STRIP ============ -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-8 grid sm:grid-cols-3 gap-6 text-center" data-stagger>
      <div class="fade-in-up">
        <p class="font-serif font-bold text-navy text-sm md:text-base">Canadian-Owned &amp; Operated</p>
      </div>
      <div class="fade-in-up">
        <p class="font-serif font-bold text-navy text-sm md:text-base">Real Research Behind Every Title</p>
      </div>
      <div class="fade-in-up">
        <p class="font-serif font-bold text-navy text-sm md:text-base">Free Digital Companions on Most Titles</p>
      </div>
    </div>
  </section>

  <!-- ============ SHOP VIDEO ============ -->
  <!-- Placed directly under the credibility strip, before the categories:
       it is the shop-level film (the five brand cards, not one title), so
       it belongs with the claims it illustrates rather than down among
       the individual books. -->
  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20 grid md:grid-cols-2 gap-10 md:gap-14 items-center">
      <div class="fade-in-up" data-from="left">
        <p class="text-xs font-bold uppercase tracking-widest text-forest mb-3">A Look at What We Make</p>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-navy mb-4">
          Eleven seconds, five books' worth of pages
        </h2>
        <p class="text-slate-600 leading-relaxed mb-6">
          Real covers and real interior pages — the same short film that runs on our Etsy shop.
          No stock photography, because there isn't any: every page in it came out of a book we
          actually made.
        </p>
        <CTAButton href="/books/">Browse Our Books</CTAButton>
      </div>

      <div class="fade-in-up" data-from="right">
        <!-- Inner wrapper drifts slightly against the scroll; the outer one
             owns the reveal so the two transforms never fight. -->
        <div data-parallax="0.06">
          <PromoVideo
            src="/home/shop-video.mp4"
            poster="/home/shop-video-poster.jpg"
            label="A short look at the Logicmanse books"
            class="rounded-xl shadow-xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHAT WE PUBLISH ============ -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <SectionHeading
        eyebrow="What We Publish"
        title="Four Kinds of Books, One Rule"
        subtitle="If a section doesn't earn its place on the page, it doesn't go in the book."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger>
        {CATEGORIES.map((cat) => (
          <div class="fade-in-up bg-slate-50 border border-slate-200 rounded-xl p-6">
            <h3 class="font-serif font-bold text-navy text-lg mb-2">{cat.name}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{cat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FEATURED TITLES — fanned hand ============ -->
  <!-- Replaced the pinned scroll-jacked showcase (2026-10-17): it showed one
       cover at a time and held the page for several screens. Now the whole
       shelf is fanned like a hand of cards; hover / tap / arrow keys lift one
       to the front and its details show beside it. Cards are real links, so
       with JS off the first title's details show and every cover still goes
       to its product page. -->
  <section class="bg-slate-50" data-fan style={`--n:${SHELF.length}`}>
    <div class="max-w-6xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-10 md:gap-14 items-center">
      <div class="fan" role="group" aria-label="Our books — choose a title">
        {SHELF.map((book, i) => (
          <a
            href={book.productHref}
            class="fan-card"
            style={`--i:${i}`}
            data-i={i}
            data-state={i === 0 ? 'active' : 'idle'}
            aria-label={book.title}
          >
            <img src={coverThumb(book)} alt={book.coverAlt} loading="lazy" />
          </a>
        ))}
      </div>

      <div>
        <p class="uppercase tracking-widest text-sm font-semibold text-forest mb-3">Featured Titles</p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-8">Real Books, Not Mockups</h2>

        <div class="fan-texts mb-8" aria-live="polite">
          {SHELF.map((book, i) => (
            <div class="fan-text" data-i={i} data-state={i === 0 ? 'active' : 'idle'}>
              <span class="inline-block bg-forest/10 text-forest-dark text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full mb-4">
                {book.category}
              </span>
              <h3 class="text-2xl md:text-3xl font-serif font-bold text-navy mb-3">{book.title}</h3>
              <p class="text-slate-600 leading-relaxed mb-3">{book.tagline}</p>
              <p class="text-sm text-slate-500 mb-5">{book.specs}</p>
              <a href={book.productHref} class="inline-block text-sm font-semibold text-forest hover:text-forest-dark">
                Learn more &rarr;
              </a>
            </div>
          ))}
        </div>

        <CTAButton href="/books/">See All Books</CTAButton>
      </div>
    </div>
  </section>

  <!-- ============ BRAND PROMO VIDEO ============ -->
  <!-- Added 2026-10-26: the 44s 16:9 brand promo (HyperFrames render).
       Separate from the square shop loop above on purpose: this one is
       widescreen and longer, so it gets real controls and no autoplay
       or loop. It is silent (no audio track), preload is metadata only
       so visitors who never press play pay for the poster, not the file. -->
  <section class="bg-navy text-white">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20 text-center">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color:#8fd1ae">Watch</p>
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-white mb-8">
        Books Made to Be Used, Not Just Read
      </h2>
      <video
        class="w-full aspect-video rounded-xl shadow-xl bg-navy-dark"
        src="/home/logicmanse-promo.mp4"
        poster="/home/logicmanse-promo-poster.jpg"
        aria-label="A 44-second look at LogicManse Publications: coloring books, cookbooks, log books and journals"
        controls
        playsinline
        preload="metadata"
        width="1280"
        height="720"></video>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <h2 class="fade-in-up text-3xl md:text-4xl font-bold text-navy mb-4">
        Have a Book Idea or a Bulk Order?
      </h2>
      <p class="fade-in-up text-lg text-slate-600 mb-8">
        Whether it's a question about one of our titles, a bulk order, or an idea for a book that
        doesn't exist yet — we read every message ourselves.
      </p>
      <div class="fade-in-up">
        <CTAButton href="/contact/">Get in Touch</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Hand-of-cards selector for the featured titles. Hover (mouse), focus,
  // arrow keys and the first tap on a card bring it to the front; a tap on
  // the already-front card follows its link. Without JS the first title
  // stays selected and every card is still an ordinary link.
  const fan = document.querySelector<HTMLElement>('[data-fan]');
  if (fan) {
    const cards = Array.from(fan.querySelectorAll<HTMLAnchorElement>('.fan-card'));
    const texts = Array.from(fan.querySelectorAll<HTMLElement>('.fan-text'));
    let active = 0;
    let hoverTimer: number | undefined;

    const select = (idx: number) => {
      if (idx === active) return;
      active = idx;
      cards.forEach((el, i) => (el.dataset.state = i === idx ? 'active' : 'idle'));
      texts.forEach((el, i) => (el.dataset.state = i === idx ? 'active' : 'idle'));
    };

    cards.forEach((card, i) => {
      card.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        // Short delay so sweeping across the fan doesn't flicker through titles.
        hoverTimer = window.setTimeout(() => select(i), 60);
      });
      card.addEventListener('pointerleave', () => window.clearTimeout(hoverTimer));
      card.addEventListener('focus', () => select(i));
      card.addEventListener('click', (e) => {
        if (i !== active) {
          e.preventDefault();
          select(i);
        }
      });
      card.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        cards[(i + step + cards.length) % cards.length].focus();
      });
    });
  }
</script>
