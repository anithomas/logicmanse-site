---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import ReelStrip from '../components/ReelStrip.astro';
import { SITE } from '../data/site';
import { CREATOR, TAKES } from '../data/creator';
---

<BaseLayout
  title="Cinematic Portfolios for UGC Creators"
  description="Reelcase turns your best takes into a cinematic portfolio — the kind of reel that gets a creator a callback, not a scroll-past."
>
  <div class="reelcase">
    <!-- ============ HERO — letterboxed frame ============ -->
    <section class="relative overflow-hidden grain">
      <div class="letterbox-bar"></div>

      <div class="max-w-5xl mx-auto px-6 py-14 md:py-20 text-center relative">
        <p class="fade-in-up timecode uppercase tracking-widest text-xs md:text-sm mb-6 flex items-center justify-center gap-2">
          <span class="rec-dot"></span> Reelcase — Take 01
        </p>
        <h1 class="fade-in-up font-display uppercase text-print text-4xl md:text-6xl leading-[1.05] tracking-wide mb-6">
          {SITE.tagline}
        </h1>
        <p class="fade-in-up font-body text-lg md:text-xl text-print/70 max-w-2xl mx-auto mb-10 leading-relaxed">
          {SITE.subTagline}
        </p>
        <div class="fade-in-up flex flex-wrap items-center justify-center gap-4">
          <CTAButton href="/contact/">Get Early Access</CTAButton>
          <CTAButton href="#how-it-works" variant="outline">See How It Works</CTAButton>
        </div>
      </div>

      <!-- ============ FLAGSHIP DEMO — a real Reelcase portfolio ============ -->
      <div class="max-w-5xl mx-auto px-6 pb-16 relative">
        <div class="fade-in-up flex flex-wrap items-end justify-between gap-4 mb-6 text-left">
          <div>
            <p class="timecode uppercase tracking-widest text-xs mb-1">This is a real Reelcase — Priya's slate</p>
            <p class="font-display uppercase text-2xl md:text-3xl tracking-wide">{CREATOR.name} <span class="text-tungsten">{CREATOR.handle}</span></p>
            <p class="font-body text-sm text-print/60 mt-1">{CREATOR.niche} &middot; {CREATOR.location}</p>
          </div>
          <div class="flex gap-6">
            {CREATOR.stats.map((stat) => (
              <div class="text-right">
                <p class="font-display text-2xl md:text-3xl text-tungsten leading-none">{stat.value}</p>
                <p class="timecode text-[0.65rem] uppercase tracking-wide mt-1">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="fade-in-up">
          <ReelStrip takes={TAKES} />
        </div>

        <p class="fade-in-up font-body text-sm text-print/50 italic mt-6 max-w-2xl">
          &ldquo;{CREATOR.bio}&rdquo;
        </p>
      </div>

      <div class="letterbox-bar"></div>
    </section>

    <!-- ============ PROBLEM / SOLVE ============ -->
    <section class="bg-reel">
      <div class="max-w-6xl mx-auto px-6 py-20">
        <SectionHeading
          reelcase
          eyebrow="The Problem"
          title="A Linktree Isn't a Portfolio"
          subtitle="Most creators pitch brands with five shaky clips and no context. Reelcase gives every take a frame, a hook, and a result — so it actually gets watched."
        />

        <div class="grid md:grid-cols-2 gap-8">
          <div class="fade-in-up bg-negative border border-white/10 rounded-xl p-8">
            <p class="timecode text-xs uppercase tracking-wide mb-4">Before — Scroll Past</p>
            <ul class="space-y-4 text-print/70 font-body">
              <li class="flex gap-3">
                <span class="text-ash font-bold">&times;</span>
                A link-in-bio folder of raw clips with no context for the brand you're pitching
              </li>
              <li class="flex gap-3">
                <span class="text-ash font-bold">&times;</span>
                Your best take is buried three scrolls deep in a camera roll export
              </li>
              <li class="flex gap-3">
                <span class="text-ash font-bold">&times;</span>
                Every pitch email starts from zero, re-explaining who you are
              </li>
            </ul>
          </div>

          <div class="fade-in-up bg-reel-light border border-tungsten/30 rounded-xl p-8">
            <p class="timecode text-xs uppercase tracking-wide mb-4 text-tungsten">After — Callback</p>
            <ul class="space-y-4 text-print font-body">
              <li class="flex gap-3">
                <span class="text-tungsten font-bold">&#10003;</span>
                A cinematic reel that plays like a show reel, not a random folder
              </li>
              <li class="flex gap-3">
                <span class="text-tungsten font-bold">&#10003;</span>
                Every take framed with the brand, the hook, and the category — instantly scannable
              </li>
              <li class="flex gap-3">
                <span class="text-tungsten font-bold">&#10003;</span>
                One link, dropped straight into a pitch email, that actually gets opened
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section id="how-it-works" class="bg-reel-light">
      <div class="max-w-6xl mx-auto px-6 py-20">
        <SectionHeading
          reelcase
          eyebrow="The Process"
          title="Three Takes to a Finished Slate"
          subtitle="No editing software, no timeline to wrangle. You supply the footage — we cut the story."
        />

        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              n: '01',
              title: 'Upload Your Takes',
              body: 'Drop in the clips you already have — GRWMs, unboxings, testimonials, whatever you’ve shot. No reshoots required.',
            },
            {
              n: '02',
              title: 'We Cut Your Reel',
              body: 'Every take gets framed, tagged, and sequenced into a scrubbable portfolio built to be watched, not skimmed.',
            },
            {
              n: '03',
              title: 'Share Your Slate',
              body: 'One cinematic link. Drop it in a pitch email, your bio, or a brand’s inbox — and let the reel do the talking.',
            },
          ].map((step) => (
            <div class="fade-in-up bg-negative border border-white/10 rounded-xl p-8">
              <p class="font-display text-tungsten text-4xl mb-4">{step.n}</p>
              <p class="font-display uppercase tracking-wide text-xl mb-3">{step.title}</p>
              <p class="font-body text-print/70 leading-relaxed">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA ============ -->
    <section class="bg-reel grain relative overflow-hidden">
      <div class="max-w-3xl mx-auto px-6 py-20 text-center relative">
        <p class="fade-in-up timecode uppercase tracking-widest text-xs mb-4">Fade In — Your Slate</p>
        <h2 class="fade-in-up font-display uppercase text-print text-3xl md:text-5xl tracking-wide mb-4">
          Ready to Cut Your Reel?
        </h2>
        <p class="fade-in-up font-body text-lg text-print/70 mb-8 max-w-xl mx-auto">
          Get early access and be one of the first creators with a Reelcase portfolio in your pitch
          deck.
        </p>
        <div class="fade-in-up">
          <CTAButton href="/contact/">Get Early Access</CTAButton>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
