---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import { SITE } from '../data/site';

const CATEGORIES = [
  {
    name: 'Coloring & Activity Books',
    description: 'Mazes, word searches, and coloring pages kids actually finish — not just start.',
  },
  {
    name: 'Log Books & Record Books',
    description: 'Built around a real full year of use, not a generic 4-property template.',
  },
  {
    name: 'Journals',
    description: 'Simple, guided pages that get used past the first week.',
  },
  {
    name: 'Cookbooks',
    description: 'Recipes organized around how you actually cook, not how a magazine lays out a page.',
  },
];

const FEATURED = [
  {
    category: 'Coloring & Activity Book',
    title: 'Super Leia to the Rescue!',
    description: 'A coloring & activity book inspired by a real dog — 30 pages, mazes, and word searches.',
    href: '/LeiaColoringBook/',
  },
  {
    category: 'Log Book',
    title: 'Rental Property Record Book',
    description: 'A record book for a landlord managing 1–6 properties, built for a full year of real use.',
    href: '/RentalManagementLog/',
  },
];
---

<BaseLayout
  title="Coloring Books, Log Books, Journals & Cookbooks"
  description="Logicmanse Solutions publishes coloring books, log books, journals, and cookbooks designed around how you actually use them."
>
  <!-- ============ HERO ============ -->
  <section class="bg-navy text-white">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-6xl leading-tight mb-6">
        {SITE.tagline}
      </h1>
      <p class="fade-in-up text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-10 leading-relaxed">
        {SITE.subTagline}
      </p>
      <div class="fade-in-up flex flex-wrap items-center justify-center gap-4">
        <CTAButton href="/books/">Browse Our Books</CTAButton>
        <a
          href="/contact/"
          class="inline-block border border-white/30 hover:border-white text-white font-semibold px-6 py-3 rounded-md transition-colors"
        >
          Get in Touch
        </a>
      </div>

      <!--
        TODO (Ani): replace this placeholder with a real photo — a stack
        of finished books, or a cover flat-lay. Drop the file in /public/
        and swap the src below.
      -->
      <div class="fade-in-up mt-14 max-w-3xl mx-auto aspect-video rounded-xl border-2 border-dashed border-white/20 flex items-center justify-center text-white/40 text-sm">
        Add a photo of the books here
      </div>
    </div>
  </section>

  <!-- ============ CREDIBILITY STRIP ============ -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-8 grid sm:grid-cols-3 gap-6 text-center">
      <div class="fade-in-up">
        <p class="font-serif font-bold text-navy text-sm md:text-base">Canadian-Owned &amp; Operated</p>
      </div>
      <div class="fade-in-up">
        <p class="font-serif font-bold text-navy text-sm md:text-base">Real Research Behind Every Title</p>
      </div>
      <div class="fade-in-up">
        <p class="font-serif font-bold text-navy text-sm md:text-base">Free Digital Companion With Every Book</p>
      </div>
    </div>
  </section>

  <!-- ============ WHAT WE PUBLISH ============ -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <SectionHeading
        eyebrow="What We Publish"
        title="Four Kinds of Books, One Rule"
        subtitle="If a section doesn't earn its place on the page, it doesn't go in the book."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {CATEGORIES.map((cat) => (
          <div class="fade-in-up bg-slate-50 border border-slate-200 rounded-xl p-6">
            <h3 class="font-serif font-bold text-navy text-lg mb-2">{cat.name}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{cat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FEATURED TITLES ============ -->
  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <SectionHeading
        eyebrow="Featured Titles"
        title="Books We've Actually Published"
        subtitle="Real titles, not mockups — each with its own free companion download."
      />

      <div class="grid md:grid-cols-2 gap-6 mb-10">
        {FEATURED.map((book) => (
          <a
            href={book.href}
            class="fade-in-up block bg-white border border-slate-200 rounded-xl p-8 hover:border-forest/40 hover:shadow-lg transition-all duration-200"
          >
            <span class="inline-block bg-forest/10 text-forest-dark text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full mb-4">
              {book.category}
            </span>
            <h3 class="text-xl font-serif font-bold text-navy mb-2">{book.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-4">{book.description}</p>
            <span class="inline-block text-sm font-semibold text-forest">Learn more &rarr;</span>
          </a>
        ))}
      </div>

      <div class="fade-in-up text-center">
        <CTAButton href="/books/">See All Books</CTAButton>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <h2 class="fade-in-up text-3xl md:text-4xl font-bold text-navy mb-4">
        Have a Book Idea or a Bulk Order?
      </h2>
      <p class="fade-in-up text-lg text-slate-600 mb-8">
        Whether it's a question about one of our titles, a bulk order, or an idea for a book that
        doesn't exist yet — we read every message ourselves.
      </p>
      <div class="fade-in-up">
        <CTAButton href="/contact/">Get in Touch</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
