---
// Dedicated landing page for "The Complete Heart Health Log Book"
// (LogicManse Publications, Book Blueprint No. 02) — the book's own
// storefront page, same pattern as LeiaColoringBook.astro /
// RentalManagementLog.astro.
//
// WHY THIS URL EXACTLY: the book's printed back cover carries a QR code
// AND the readable URL "www.logicmanse.ca/HeartHealthLog", next to the
// line "A FREE COMPANION — A spreadsheet that mirrors the main logs."
// The blueprint (§02) and the Etsy listing kit (§11) both flag that a
// buyer scanning that code and landing nowhere is a launch blocker, so
// this page must stay live for as long as the book is in print.
//
// Palette and typography are taken from the book's own design, which is
// a third distinct visual register — Leia is a children's book, the
// rental log is a business tool, this is a medical record. Colours are
// sampled from the shipping cover, Heart_Health_Log_Book_COVER.pdf
// (NOT the stale ...COVER.png sitting beside it, which is an earlier
// render): warm cream ground #F7F0E3, sand panel #EFE2CC, a single clay
// accent #C1624F, ink #3A2F2A. That is exactly the discipline written
// down in DESIGN_PHILOSOPHY_Quiet_Accumulation.md — one warm ground,
// three neutrals, one accent, "no blues, no clinical whites, nothing
// that could be mistaken for a warning". The four typefaces are the
// cover's own too: Young Serif for the hero word, Big Shoulders for
// the secondary title, Crimson Pro for the emotional lines, IBM Plex
// Mono for the systematic markers.
//
// Self-contained (its own <head>/<body>, not BaseLayout/Header/Footer),
// same reasoning as the two sibling book pages.
//
// Route: this file's name controls the URL, so it lives at
// https://www.logicmanse.ca/HeartHealthLog/
// public/HeartHealthLog.html is a static redirect stub so the exact
// printed URL (no trailing slash) resolves here too.
import { BOOK_LINKS } from '../data/site';

const PAGE_TITLE = 'The Complete Heart Health Log Book | LogicManse Publications';
const PAGE_DESCRIPTION =
  'A 118-page undated log book for blood pressure, heart rate, weight, medicines, blood thinner doses and test results — in large print, with a free companion spreadsheet.';
const CANONICAL_URL = 'https://www.logicmanse.ca/HeartHealthLog/';

// Where this book is sold. Both URLs live in src/data/site.ts so there
// is one file to edit when a listing goes live; an empty string renders
// a non-clickable "Coming soon" chip instead of a dead link.
//
// NOTE on the funnel: the printed back cover promises "A FREE COMPANION —
// a spreadsheet that mirrors the main logs" at this exact URL, so the
// free companion is described below as something every copy includes.
// It is not offered as a download button here on Ani's instruction —
// the page's job is now the two storefronts.
const { etsy: ETSY_URL, amazon: AMAZON_URL } = BOOK_LINKS.heartHealth;

// Verbatim from the book's own back cover, under "INSIDE".
const INSIDE = [
  '52 weekly pages — a whole week visible at a glance, in large, easy-to-read print',
  '12 monthly reviews, with a daily weight chart and room for the questions you forget',
  'Blood pressure, heart rate, weight, and morning-noon-evening-bedtime medicines',
  'A blood thinner schedule built for a dose that changes with the day of the week',
  'Surgery history, valve and device records, procedures, dental visits, blood work',
  'A plain-English glossary of 78 terms, and conversion tables for kg, litres and salt',
  'Space for the results nobody ever hands you a copy of',
  'A page for whoever is helping you, so they can pick it up on a bad day',
];

// What the free download itself contains. Kept deliberately parallel to
// the printed book's own sections, because that is precisely what the
// back cover promises: "a spreadsheet that mirrors the main logs."
const COMPANION = [
  'A weekly tracking sheet that mirrors the printed weekly page — blood pressure, pulse, weight, the four medicine times, and the blood thinner dose actually taken',
  'A monthly review sheet, with the daily weight chart drawn for you as you type',
  'Your medicine list and daily schedule, in one place you can reprint whenever the schedule changes',
  'A test-results log for blood tests, other blood work, scans and heart tests',
  'Your care team, and the one-page summary card — the sheet to fill in once and photograph',
];

// ---------------------------------------------------------------------
// The cover's own graphic, re-drawn for the web.
//
// The front cover's whole idea (DESIGN_PHILOSOPHY_Quiet_Accumulation.md)
// is a lattice of EXACTLY 52 x 7 = 364 marks — one year of days — from
// which a small population departs the baseline to trace a heartbeat.
// So this is not decoration and the count is not arbitrary: per column
// the mark nearest the trace is the one that moved, which keeps the
// total at 364 rather than adding a line on top of a grid. The build
// asserts the count for the same reason the cover script does.
// ---------------------------------------------------------------------
const WEEKS = 52;
const DAYS = 7;
const COL_W = 20;
const ROW_H = 32;
const X0 = 46;   // left inset: room for the MON/SUN row labels
const Y0 = 22;
const BASELINE_Y = Y0 + 3 * ROW_H; // the MON..SUN middle row

// One beat, in pixels off the baseline: flat run, P wave, QRS, T wave,
// flat run. Reshaped the way revision 6 reshaped the printed one — the
// complex proportioned against the flat runs, so the line has rhythm.
const BEAT: Record<number, number> = {
  17: -12, 18: -19, 19: -12,
  22: 16, 23: -94, 24: 88, 25: 10,
  28: -25, 29: -33, 30: -24,
};
const traceY = (i: number) => BASELINE_Y + (BEAT[i] ?? 0);

// 6 lattice marks + 1 displaced mark per column = 7 x 52 = 364.
const columns = Array.from({ length: WEEKS }, (_, i) => {
  const x = X0 + i * COL_W;
  const ty = traceY(i);
  // The row the departed mark came from: whichever sits closest to it.
  const from = Math.round((ty - Y0) / ROW_H);
  const rows = Array.from({ length: DAYS }, (_, j) => Y0 + j * ROW_H).filter(
    (_, j) => j !== Math.min(Math.max(from, 0), DAYS - 1)
  );
  return { x, ty, rows };
});

const markCount = columns.reduce((n, c) => n + c.rows.length + 1, 0);
if (markCount !== 364) {
  throw new Error(`Cover field must carry exactly 364 marks, got ${markCount}`);
}

const FIELD_W = X0 * 2 + (WEEKS - 1) * COL_W;
const FIELD_H = Y0 * 2 + (DAYS - 1) * ROW_H;
const WEEK_TICKS = [1, 13, 26, 39, 52];
---

<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESCRIPTION} />
  <link rel="canonical" href={CANONICAL_URL} />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESCRIPTION} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={CANONICAL_URL} />
  <meta property="og:image" content="/heart-health-log/cover-front.jpg" />

  <!-- The cover's own four typefaces: Young Serif for the hero word,
       Big Shoulders for the secondary title, Crimson Pro for the
       emotional lines, IBM Plex Mono for the systematic markers. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Big+Shoulders+Display:wght@700&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="wrap">
    <div class="logo-row">
      <img src="/heart-health-log/logo.png" alt="LogicManse">
    </div>

    <!-- The physical front cover, re-drawn: the same title lockup, the
         same strapline, the same field of 364 marks. Someone who scanned
         the QR code is holding this — the page should be recognisable as
         the same object before they read a word of it. -->
    <header class="cover">
      <h1 class="cover-title">
        <span class="cover-the">The Complete</span>
        <span class="cover-hero">Heart</span>
        <span class="cover-rest">Health Log Book</span>
      </h1>

      <p class="cover-strap">
        Blood pressure · heart rate · weight · blood-thinner doses · morning to bedtime medicines
      </p>

      <svg
        class="field"
        viewBox={`0 0 ${FIELD_W} ${FIELD_H + 46}`}
        role="img"
        aria-label="A lattice of 364 marks — 52 weeks by 7 days — with one line of them departing to trace a heartbeat"
      >
        <text class="field-day" x="0" y={Y0 + 4}>MON</text>
        <text class="field-day" x="0" y={Y0 + 6 * ROW_H + 4}>SUN</text>

        {columns.map((col) => (
          <>
            {col.rows.map((y) => <circle class="mark" cx={col.x} cy={y} r="2.1" />)}
            <circle class="mark-moved" cx={col.x} cy={col.ty} r="2.8" />
          </>
        ))}

        <polyline
          class="trace"
          points={columns.map((c) => `${c.x},${c.ty}`).join(' ')}
          fill="none"
        />

        {WEEK_TICKS.map((w) => (
          <text class="field-week" x={X0 + (w - 1) * COL_W} y={FIELD_H + 16}>
            {String(w).padStart(2, '0')}
          </text>
        ))}
        <text class="field-caption" x={FIELD_W / 2} y={FIELD_H + 38}>
          364 MARKS — ONE YEAR, ONE DAY AT A TIME
        </text>
      </svg>

      <p class="cover-who">
        For anyone living with a heart condition that is managed rather than cured — and for
        whoever is helping them.
      </p>
      <p class="cover-specs">Undated · 8.5" × 11" · 118 pages · by @Antz</p>
    </header>

    <div class="card">
      <p class="eyebrow">Get the book</p>
      <h2>Two ways to start</h2>
      <p class="card-sub">
        Print it at home today, or have the paperback delivered. Same 118 pages either way.
      </p>

      <div class="buys">
        {ETSY_URL ? (
          <a class="buy buy-primary" href={ETSY_URL} rel="noopener">
            <span class="buy-kind">Digital · instant download</span>
            <span class="buy-store">Buy on Etsy →</span>
          </a>
        ) : (
          <span class="buy buy-soon">
            <span class="buy-kind">Digital · instant download</span>
            <span class="buy-store">Etsy — coming soon</span>
          </span>
        )}

        {AMAZON_URL ? (
          <a class="buy buy-primary" href={AMAZON_URL} rel="noopener">
            <span class="buy-kind">Paperback · delivered</span>
            <span class="buy-store">Buy on Amazon →</span>
          </a>
        ) : (
          <span class="buy buy-soon">
            <span class="buy-kind">Paperback · delivered</span>
            <span class="buy-store">Amazon — coming soon</span>
          </span>
        )}
      </div>

      <div class="included">
        <p class="included-title">Every copy includes a free companion spreadsheet</p>
        <ul class="features">
          {COMPANION.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <!-- The single strongest piece of copy the book has, and the thing
         no competitor can match. Verbatim from the back cover. -->
    <blockquote class="origin">
      <p>
        This book wasn't designed in an office. It was worked out at a kitchen table, in the
        months after someone in my family came home from heart surgery.
      </p>
      <p class="origin-body">
        A blood test whose result changed the dose. A dose that was different on different days
        of the week. Four separate pill times a day. Five specialists who each asked the same
        questions. What was needed was one book — the whole picture in one place, in
        handwriting, that could be carried into an appointment.
      </p>
      <cite>— @Antz</cite>
    </blockquote>

    <section class="book">
      <h2>One book instead of four</h2>
      <ul class="features inside">
        {INSIDE.map((item) => <li>{item}</li>)}
      </ul>
      <p class="who">
        For anyone after heart surgery, on a blood thinner, managing several daily medicines —
        or caring for someone who is.
      </p>
    </section>

    <div class="gallery">
      <figure class="ph-portrait">
        <img src="/heart-health-log/cover-front.jpg" alt="The Complete Heart Health Log Book cover" />
      </figure>
      <figure class="ph-square">
        <img
          src="/heart-health-log/interior-page.jpg"
          alt="A sample interior page: the blood thinner prescribed-schedule log"
        />
      </figure>
    </div>

    <!-- The book's own promise, and the reason it clears KDP's rules on
         medical guidance. Repeated here because it is the trust argument
         a reader is weighing on this page too. -->
    <div class="panel">
      <p class="panel-title">Not one number in here is ours</p>
      <p>
        There is no target range, no dosage and no warning sign printed anywhere in this book.
        Every one of them is a blank line — because they are set for you personally, by the
        people looking after you. This is simply where yours go.
      </p>
    </div>

    <p class="disclaimer">
      A blank record book for organising information given to you by your own care team. Not
      medical advice, and it contains no medical guidance, target values, dosages or warning
      signs. Always follow the instructions of your own doctor, clinic or pharmacist.
    </p>

    <footer>
      Written by @Antz · A LogicManse Publication<br>
      <a href="/">logicmanse.ca</a>
    </footer>
  </div>

  <style>
    /* One warm ground, three neutrals, one accent — sampled straight off
       Heart_Health_Log_Book_COVER.pdf, and the exact discipline set out
       in DESIGN_PHILOSOPHY_Quiet_Accumulation.md. Do not add a second
       accent colour here; the clay carries all the heat on purpose. */
    :root {
      --ground: #F7F0E3;     /* cover ground */
      --sand: #EFE2CC;       /* cover's quote/feature panel */
      --lattice: #D8C3A0;    /* the 364-mark lattice, used for hairlines */
      --ink: #3A2F2A;        /* cover title ink */
      --soft-ink: #7A6A60;
      --faint: #A8998C;
      --clay: #C1624F;       /* the single accent */
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Crimson Pro", Georgia, "Times New Roman", serif;
      font-size: 18px;
      color: var(--ink);
      background: var(--ground);
    }
    .wrap { max-width: 720px; margin: 0 auto; padding: 40px 24px 80px; }
    .logo-row { display: flex; align-items: center; justify-content: center; margin-bottom: 36px; }
    .logo-row img { height: 44px; }

    /* IBM Plex Mono at small sizes with wide letterspacing is the book's
       "specimen label" voice — used only for markers, never body copy. */
    .eyebrow {
      font-family: "IBM Plex Mono", ui-monospace, "Courier New", monospace;
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--soft-ink);
      margin: 0 0 10px;
    }

    /* ---- The cover, re-drawn ---------------------------------------
       Three unequal registers with a severe hierarchy between them, per
       DESIGN_PHILOSOPHY_Monumental_Tenderness.md: one hero word, and
       everything else drops by an order of magnitude rather than a step.
       That is what lets the cover read small and stay calm large. */
    .cover { text-align: center; margin: 0 0 46px; }
    .cover-title { margin: 0; font-weight: normal; }
    .cover-title span { display: block; }
    .cover-the {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.4em;
      text-indent: 0.4em;         /* balance the trailing letterspace */
      text-transform: uppercase;
      color: var(--soft-ink);
      margin-bottom: 6px;
    }
    .cover-hero {
      font-family: "Young Serif", Georgia, serif;
      font-size: clamp(3.6rem, 13vw, 6.6rem);
      line-height: 0.92;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .cover-rest {
      font-family: "Big Shoulders Display", "Arial Narrow", sans-serif;
      font-weight: 700;
      font-size: clamp(1.9rem, 6.4vw, 3.1rem);
      line-height: 1;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink);
      margin-top: 2px;
    }
    .cover-strap {
      font-style: italic;
      font-size: 1.02rem;
      line-height: 1.45;
      color: var(--soft-ink);
      max-width: 30em;
      margin: 20px auto 0;
      padding-top: 18px;
      border-top: 1px solid var(--lattice);
    }

    .field { display: block; width: 100%; height: auto; margin: 26px 0 4px; overflow: visible; }
    .mark { fill: var(--lattice); }
    .mark-moved { fill: var(--clay); }
    .trace { stroke: var(--clay); stroke-width: 2.6; stroke-linejoin: round; }
    .field-day, .field-week, .field-caption {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      fill: var(--faint);
    }
    .field-day { font-size: 11px; letter-spacing: 0.1em; }
    .field-week { font-size: 11px; letter-spacing: 0.1em; text-anchor: middle; }
    .field-caption { font-size: 11px; letter-spacing: 0.22em; text-anchor: middle; }

    .cover-who {
      font-style: italic;
      font-size: 1.12rem;
      line-height: 1.5;
      color: var(--ink);
      max-width: 26em;
      margin: 22px auto 14px;
    }
    .cover-specs {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--faint);
      margin: 0;
    }

    .card-sub { color: var(--soft-ink); line-height: 1.5; margin: 8px 0 0; }

    .card {
      background: #fff;
      border: 1px solid var(--lattice);
      border-top: 4px solid var(--clay);
      border-radius: 10px;
      padding: 32px 30px;
      box-shadow: 0 6px 24px rgba(58, 47, 42, 0.07);
      margin-bottom: 40px;
    }
    .card h2 { margin: 0; font-size: 1.35rem; font-weight: 600; color: var(--ink); }

    ul.features { list-style: none; padding: 0; margin: 20px 0 30px; }
    ul.features li {
      padding: 11px 0 11px 26px;
      position: relative;
      line-height: 1.5;
      border-bottom: 1px solid rgba(216, 195, 160, 0.45);
    }
    ul.features li:last-child { border-bottom: none; }
    ul.features li::before {
      content: "";
      position: absolute;
      left: 6px;
      top: 20px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--clay);
    }

    /* Two storefronts, equal weight — one hierarchy decision, not two.
       A book someone can print at home tonight and a book that arrives
       in the post are different products to different buyers, so neither
       is the "real" one. */
    .buys {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 22px 0 4px;
    }
    .buy {
      display: flex;
      flex-direction: column;
      gap: 5px;
      text-align: center;
      padding: 16px 18px;
      border-radius: 8px;
      text-decoration: none;
    }
    .buy-kind {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.75;
    }
    .buy-store { font-size: 1.05rem; font-weight: 600; line-height: 1.2; }

    .buy-primary {
      background: var(--ink);
      color: var(--ground) !important;
      transition: transform 0.1s ease, background 0.15s ease;
    }
    .buy-primary:hover { background: var(--clay); transform: translateY(-1px); }

    /* Not on sale yet. Deliberately a <span>, not a disabled-looking
       link — there is nothing to click, and saying so plainly beats a
       button that swallows a tap. */
    .buy-soon {
      background: var(--ground);
      border: 1px dashed var(--lattice);
      color: var(--faint);
      cursor: default;
    }

    .included {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid var(--lattice);
    }
    .included-title {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink);
      margin: 0;
    }
    .included .features { margin-bottom: 0; }

    .origin {
      margin: 0 0 40px;
      padding: 0 0 0 22px;
      border-left: 3px solid var(--clay);
    }
    .origin p {
      font-style: italic;
      font-size: 1.22rem;
      line-height: 1.5;
      color: var(--ink);
      margin: 0 0 16px;
    }
    .origin .origin-body {
      font-style: normal;
      font-size: 1.05rem;
      color: var(--soft-ink);
    }
    .origin cite {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-style: normal;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      color: var(--soft-ink);
    }

    .book { margin-bottom: 40px; }
    .book h2 {
      font-size: 1.9rem;
      font-weight: 600;
      color: var(--ink);
      margin: 0 0 6px;
    }
    .book h2::after {
      content: "";
      display: block;
      width: 62px;
      height: 3px;
      background: var(--clay);
      margin-top: 10px;
    }
    ul.inside { margin-top: 18px; }
    .who { font-style: italic; color: var(--soft-ink); line-height: 1.5; margin: 0; }

    /* Same true-aspect-ratio approach as the two sibling book pages: a
       portrait cover and a square listing photo have different native
       shapes, and force-cropping both into one box hides content. */
    .gallery {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }
    .gallery figure {
      margin: 0;
      height: 300px;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(58, 47, 42, 0.16);
    }
    .gallery figure.ph-portrait { aspect-ratio: 1082 / 1400; }
    .gallery figure.ph-square { aspect-ratio: 1 / 1; }
    .gallery img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .panel {
      background: var(--sand);
      border-left: 4px solid var(--clay);
      padding: 24px 26px;
      border-radius: 3px;
      margin-bottom: 34px;
    }
    .panel p { margin: 0; line-height: 1.55; color: var(--ink); }
    .panel-title {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.72rem !important;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--soft-ink) !important;
      margin-bottom: 12px !important;
    }

    .disclaimer {
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--faint);
      margin: 0;
    }

    @media (max-width: 480px) {
      .book h2 { font-size: 1.5rem; }
      .card { padding: 26px 20px; }
      .gallery { gap: 10px; }
      .gallery figure { height: 190px; }
      /* The tracked mono markers are the first thing to overrun a narrow
         column — tighten them rather than let the byline wrap alone. */
      .cover-specs { letter-spacing: 0.1em; }
      .cover-the { letter-spacing: 0.3em; text-indent: 0.3em; }
      .cover-who { font-size: 1.02rem; }
      .buys { grid-template-columns: 1fr; }
    }

    footer {
      text-align: center;
      margin-top: 50px;
      padding-top: 26px;
      border-top: 1px solid var(--lattice);
      font-size: 0.9rem;
      color: var(--soft-ink);
    }
    footer a { color: var(--clay); text-decoration: none; font-weight: 600; }
  </style>
</body>
</html>
