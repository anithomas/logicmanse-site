---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';

// Real, currently-published or in-production titles. Each links out to its
// own dedicated landing page (built separately per book, own branding —
// see LeiaColoringBook.astro / RentalManagementLog.astro) rather than
// duplicating that content here.
const titles = [
  {
    category: 'Coloring & Activity Book',
    title: 'Super Leia to the Rescue!',
    description:
      "A coloring & activity book inspired by a real dog named Leia — mazes, word searches, and 30 coloring pages, with a free bonus color pack and real photos for kids and parents.",
    href: '/LeiaColoringBook/',
    cta: 'Get the Free Color Pack',
    status: 'Available',
  },
  {
    category: 'Log Book',
    title: 'Rental Property Record Book',
    description:
      'A record book for a landlord managing 1–6 properties — rent tracking, tenant & lease logs, maintenance, mileage, and a portfolio-wide annual summary built for tax time.',
    href: '/RentalManagementLog/',
    cta: 'Get the Free Digital Tracker',
    status: 'Coming soon',
  },
];
---

<BaseLayout
  title="Books"
  description="Coloring books, log books, journals, and cookbooks from Logicmanse Solutions."
>
  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-5xl mb-4">Our Books</h1>
      <p class="fade-in-up text-lg text-white/80 max-w-2xl mx-auto">
        Coloring books, log books, journals, and cookbooks — each one built around a real, specific
        need, not a template with the title swapped out.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 py-20 grid gap-8">
      {titles.map((book) => (
        <a
          href={book.href}
          class="fade-in-up block bg-slate-50 border border-slate-200 rounded-xl p-8 hover:border-forest/40 hover:shadow-lg transition-all duration-200"
        >
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <span class="inline-block bg-forest/10 text-forest-dark text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full">
              {book.category}
            </span>
            <span class="inline-block text-xs font-bold uppercase tracking-wide text-slate-400">
              {book.status}
            </span>
          </div>
          <h2 class="text-2xl font-serif font-bold text-navy mb-3">{book.title}</h2>
          <p class="text-slate-600 leading-relaxed mb-4">{book.description}</p>
          <span class="inline-block text-sm font-semibold text-forest">
            {book.cta} &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <SectionHeading
        title="More Titles on the Way"
        subtitle="Journals and cookbooks are next in the queue — reach out if there's something specific you'd like to see."
      />
      <div class="fade-in-up">
        <CTAButton href="/contact/">Get in Touch</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
