---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import { DISPLAY_SHELF, coverThumb, bookByKey, seriesBadge } from '../data/books';
import { isForSale } from '../data/site';

// Every card links to that title's PRODUCT page (/books/<slug>/), never
// to its printed QR URL — the QR pages are for readers who already own
// the book. See the note at the top of src/data/books.ts.
//
// Status is derived from the store links rather than typed by hand, so
// this listing can never claim a title is available while its own
// product page still shows "coming soon" chips.
//
// Grouped by category (added 2026-09-30, per the owner: a flat list of a
// coloring book, two log books and a cookbook read as scattered rather
// than "a publisher who makes several kinds of practical books, on
// purpose" — see the About page's own framing, which this now carries
// through). Order within CATEGORY_ORDER is deliberate (owner, same day):
// coloring and cookbooks lead, log books sit third — log books are
// comparatively low-content, so they shouldn't be the first thing a new
// visitor sees this publisher as. Keep this order in sync with
// CATEGORIES in src/pages/index.astro, the other fixed-order category
// list on the site. A category with no title on the live SHELF yet is
// simply skipped, so this never shows an empty section.
const CATEGORY_ORDER = [
  {
    name: 'Coloring & Activity Book',
    blurb: 'For kids — coloring pages, mazes and early-learning workbooks built to actually get finished, not just started.',
  },
  {
    name: 'Cookbook',
    blurb: 'Recipes organized around how you actually cook, not how a magazine lays out a page.',
  },
  {
    name: 'Log Book',
    blurb: 'For a real year of use — rent, tenants, medicines, whatever your household or property actually needs tracked.',
  },
  {
    name: 'Journal',
    blurb: 'Simple, guided pages that get used past the first week.',
  },
] as const;

const GROUPS = CATEGORY_ORDER.map((c) => ({
  ...c,
  items: DISPLAY_SHELF.filter(
    (item) => (item.kind === 'book' ? item.book.category : item.series.category) === c.name
  ),
})).filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Books"
  description="Practical books from LogicManse Publications: a kids' coloring book, a Kerala family cookbook, and log books for rentals, renovations and heart health."
>
  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-5xl mb-4 text-white">Our Books</h1>
      <p class="fade-in-up text-lg text-white/80 max-w-2xl mx-auto">
        We don't publish one kind of book — we publish practical books, in whatever category the
        same discipline applies. Every title starts from a real, specific need, not a template
        with the title swapped out.
      </p>
    </div>
  </section>

  {GROUPS.map((group) => (
    <section class="bg-white border-b border-slate-100 last:border-b-0">
      <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
        <div class="fade-in-up mb-10">
          <span class="inline-block bg-forest/10 text-forest-dark text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full mb-3">
            {group.name}{group.items.length > 1 ? 's' : ''}
          </span>
          <p class="text-slate-600 max-w-xl">{group.blurb}</p>
        </div>

        <div class="grid gap-8">
          {group.items.map((item) => item.kind === 'book' ? (
            <a
              href={item.book.productHref}
              class="fade-in-up grid sm:grid-cols-[auto_1fr] gap-6 items-start bg-slate-50 border border-slate-200 rounded-xl p-8 hover:border-forest/40 hover:shadow-lg transition-all duration-200"
            >
              <img
                src={coverThumb(item.book)}
                alt={item.book.coverAlt}
                loading="lazy"
                decoding="async"
                class="rounded shadow-md w-28 h-auto justify-self-center sm:justify-self-start"
              />
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class="inline-block text-xs font-bold uppercase tracking-wide text-slate-400">
                    {isForSale(item.book.key) ? 'Available' : 'Coming soon'}
                  </span>
                </div>
                <h2 class="text-2xl font-serif font-bold text-navy mb-3">{item.book.title}</h2>
                <p class="text-slate-600 leading-relaxed mb-3">{item.book.description}</p>
                <p class="text-xs uppercase tracking-wide text-slate-400 mb-4">{item.book.specs}</p>
                <span class="inline-block text-sm font-semibold text-forest">See the book &rarr;</span>
              </div>
            </a>
          ) : (
            <a
              href={item.series.productHref}
              class="fade-in-up grid sm:grid-cols-[auto_1fr] gap-6 items-start bg-slate-50 border border-slate-200 rounded-xl p-8 hover:border-forest/40 hover:shadow-lg transition-all duration-200"
            >
              <div class="relative shrink-0 justify-self-center sm:justify-self-start" style="width:8.5rem; height:7rem;">
                {item.series.books.map((key, i) => (
                  <img
                    src={coverThumb(bookByKey(key))}
                    alt=""
                    class="absolute top-0 rounded shadow-md w-20 h-auto"
                    style={`left:${i * 1.6}rem; z-index:${10 - i}`}
                  />
                ))}
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class="inline-block text-xs font-bold uppercase tracking-wide text-forest-dark bg-forest/10 px-3 py-1 rounded-full">
                    {seriesBadge(item.series)}
                  </span>
                </div>
                <h2 class="text-2xl font-serif font-bold text-navy mb-3">{item.series.title}</h2>
                <p class="text-slate-600 leading-relaxed mb-3">{item.series.tagline}</p>
                <p class="text-xs uppercase tracking-wide text-slate-400 mb-4">{item.series.specs}</p>
                <span class="inline-block text-sm font-semibold text-forest">See the series &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="bg-slate-50">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <SectionHeading
        title="Have a Book Idea?"
        subtitle="Tell us what you'd actually use, and what's missing from what's already out there."
      />
      <div class="fade-in-up">
        <CTAButton href="/contact/">Get in Touch</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
