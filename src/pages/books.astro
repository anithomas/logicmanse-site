---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import { BOOKS } from '../data/books';
import { BOOK_LINKS } from '../data/site';

// Every card links to that title's PRODUCT page (/books/<slug>/), never
// to its printed QR URL — the QR pages are for readers who already own
// the book. See the note at the top of src/data/books.ts.
//
// Status is derived from BOOK_LINKS rather than typed by hand, so this
// listing can never claim a title is available while its own product
// page still shows "coming soon" chips.
const statusOf = (key: keyof typeof BOOK_LINKS) =>
  BOOK_LINKS[key].etsy || BOOK_LINKS[key].amazon ? 'Available' : 'Coming soon';
---

<BaseLayout
  title="Books"
  description="Coloring books, log books, journals, and cookbooks from Logicmanse Solutions."
>
  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-5xl mb-4 text-white">Our Books</h1>
      <p class="fade-in-up text-lg text-white/80 max-w-2xl mx-auto">
        Coloring books, log books, journals, and cookbooks — each one built around a real, specific
        need, not a template with the title swapped out.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 py-20 grid gap-8">
      {BOOKS.map((book) => (
        <a
          href={book.productHref}
          class="fade-in-up grid sm:grid-cols-[auto_1fr] gap-6 items-start bg-slate-50 border border-slate-200 rounded-xl p-8 hover:border-forest/40 hover:shadow-lg transition-all duration-200"
        >
          <img
            src={book.cover}
            alt={book.coverAlt}
            class="rounded shadow-md w-28 h-auto justify-self-center sm:justify-self-start"
          />
          <div>
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="inline-block bg-forest/10 text-forest-dark text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full">
                {book.category}
              </span>
              <span class="inline-block text-xs font-bold uppercase tracking-wide text-slate-400">
                {statusOf(book.key)}
              </span>
            </div>
            <h2 class="text-2xl font-serif font-bold text-navy mb-3">{book.title}</h2>
            <p class="text-slate-600 leading-relaxed mb-3">{book.description}</p>
            <p class="text-xs uppercase tracking-wide text-slate-400 mb-4">{book.specs}</p>
            <span class="inline-block text-sm font-semibold text-forest">See the book &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <SectionHeading
        title="More Titles on the Way"
        subtitle="Journals and cookbooks are next in the queue — reach out if there's something specific you'd like to see."
      />
      <div class="fade-in-up">
        <CTAButton href="/contact/">Get in Touch</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
