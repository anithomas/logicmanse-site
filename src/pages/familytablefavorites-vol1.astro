---
// Printed-URL page for "Family Table Favorites, Volume One".
//
// UNLIKE the other three titles' printed-QR pages (Leia, Rental, Heart
// Health), this book's back cover does NOT promise a free bonus there —
// it prints "SCAN OR VISIT www.logicmanse.ca/familytablefavorites-vol1 /
// More from our kitchen, and news on Volumes Two and Three." (see the
// cover file, FTF_Vol1_KDP_Cover_8.5x11_StandardColor_158pp.pdf, and
// FTF_Vol1_KDP_Publishing_Kit.md §4's pre-publish checklist). So this page
// is a welcome/hub page for someone holding the book, not a giveaway page:
// where to get every format, a review ask, and what's coming next. When a
// digital companion exists for this title, add a #companion section here
// the same way the other three do — see companionOffer in books.ts.
//
// The Reach sign-up card below is a plain newsletter ask ("Stay in the
// loop"), not a free-recipe pitch — someone reading this already owns all
// 72 recipes, so offering a 5-recipe sample here would be backwards. The
// product page's own companion section (companionOffer in books.ts) is
// where that pre-purchase sample lives, aimed at people who haven't
// bought yet.
//
// WHY THIS URL EXACTLY: it's printed on the back cover next to a QR code
// and must never change. The filename is lowercase on purpose (site rule:
// new logicmanse.ca URLs are always lowercase).
//
// Brand-first (see the standing rule): built from the shared qr-brand.css
// + QrLogo used by the Leia and Rental pages — navy/forest/Merriweather/
// Inter — not a recolour to the book's own spice palette.
//
// Route: this file's name controls the URL, so it lives at
// https://www.logicmanse.ca/familytablefavorites-vol1/
// public/familytablefavorites-vol1.html is a static redirect stub so the
// exact printed URL (no trailing slash) resolves here too.
import QrLogo from '../components/QrLogo.astro';
import SocialIcons from '../components/SocialIcons.astro';
import '../styles/qr-brand.css';
import { BOOK_LINKS, SOCIAL_LINKS } from '../data/site';
import { bookBySlug } from '../data/books';

const PAGE_TITLE = 'Family Table Favorites | LogicManse Publications';
const PAGE_DESCRIPTION =
  'You’ve got the book — here’s where to find every format, and what’s coming next from Family Table Favorites.';
const CANONICAL_URL = 'https://www.logicmanse.ca/familytablefavorites-vol1/';

const { amazon } = BOOK_LINKS.familyTableFavorites;
const amazonHref = amazon.com || amazon.ca;
const youtubeHref = SOCIAL_LINKS.find((l) => l.label === 'YouTube')!.href;
// Same source list the product page's "Choose Your Edition" section reads
// from — one place for every real price and link, so the two pages can't
// drift apart. Grouped the same way too: Digital / Print subsections when
// any entry sets `kind`, one flat group otherwise.
const editions = bookBySlug('family-table-favorites-vol1').editions ?? [];
const editionGroups = editions.some((e) => e.kind)
  ? [
      { label: 'Digital Edition', items: editions.filter((e) => e.kind === 'digital') },
      { label: 'Print Editions', items: editions.filter((e) => e.kind === 'print') },
      { label: '', items: editions.filter((e) => !e.kind) },
    ].filter((g) => g.items.length > 0)
  : [{ label: '', items: editions }];
---

<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESCRIPTION} />
  <link rel="canonical" href={CANONICAL_URL} />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESCRIPTION} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={CANONICAL_URL} />
  <meta property="og:image" content="https://www.logicmanse.ca/family-table-favorites/cover-front.jpg" />
</head>
<body>
  <div class="wrap">
    <QrLogo />

    <p class="eyebrow">Thanks for cooking with us</p>
    <h1>More From Our Kitchen</h1>
    <p class="sub">
      You've got <em>Family Table Favorites, Volume One</em> — 72 Kerala classics and
      East-West family favorites, cooked and passed down at the family table. Here's where
      to find every format, and what's coming next.
    </p>

    <div class="card">
      <h2>Stay in the loop:</h2>
      <p style="margin:0 0 14px; line-height:1.55;">
        Add your email for news on Volumes Two and Three, and more recipes from our kitchen —
        no spam, just the good stuff.
      </p>
      <!-- Hostinger Reach sign-up form. Filled in by the embed script at the end of <body>. -->
      <div data-reach-form="ea7c6b0f-2a4f-45d5-9987-e93d45a12e83"></div>
    </div>

    <div class="card">
      <h2>Get the book:</h2>
      <ul class="features">
        <li>72 heirloom recipes in 15 sections, from breakfast to sweets</li>
        <li>22 full-page color images, and every recipe illustrated</li>
        <li>Clear measurements, cook's notes and the story behind each dish</li>
        <li>Keepsake pages to record your own family's recipes</li>
      </ul>

      {editionGroups.map((group) => (
        <div class="editions">
          {group.label && <p class="editions-label">{group.label}</p>}
          {group.items.map((edition) => (
            <a href={edition.href} rel="noopener" class="edition-row">
              <span>
                <span class="edition-label">{edition.label}</span>
                <span class="edition-format">{edition.format}</span>
              </span>
              <span class="edition-price">{edition.price}<br /><small>Buy &rarr;</small></span>
            </a>
          ))}
        </div>
      ))}
    </div>

    <p class="hint">
      Enjoyed these recipes? A short, honest review on Amazon helps other families find
      their way to the table.
      {amazonHref && <> <a href={amazonHref} rel="noopener">Leave a review &rarr;</a></>}
    </p>

    <div class="card">
      <h2>What's next:</h2>
      <p style="margin:0 0 10px; line-height:1.55;">
        Volume One is 72 recipes across 15 sections. Volumes Two and Three continue the
        collection with new recipes in every section — check back here for the news.
      </p>
      <p style="margin:0; line-height:1.55;">
        We're also building a hands-only cooking channel, cooking these family recipes step by
        step from the book — <a href={youtubeHref} rel="noopener">watch on YouTube &rarr;</a>
      </p>
    </div>

    <p class="hint">
      <a href="/books/family-table-favorites-vol1/">See the full book page &rarr;</a>
    </p>

    <footer>
      <div style="display:flex;justify-content:center;margin-bottom:14px;color:var(--navy);"><SocialIcons /></div>
      Written by @Antz · A LogicManse Publication<br />
      <a href="/">logicmanse.ca</a>
    </footer>
  </div>

  <style>
    /* Page-specific only — the brand look is in src/styles/qr-brand.css.
       A plain list of every real edition, same data (and the same
       Digital/Print grouping) as the product page's "Choose Your
       Edition" cards, just laid out for this page's own (non-Tailwind)
       markup. */
    .editions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 20px;
    }
    .editions-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0;
    }
    .edition-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 10px;
      text-decoration: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .edition-row:hover {
      border-color: var(--forest);
      box-shadow: 0 4px 14px rgba(11, 31, 58, 0.08);
    }
    .edition-label {
      display: block;
      font-family: Merriweather, Georgia, serif;
      font-weight: 700;
      color: var(--navy);
    }
    .edition-format {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 2px;
    }
    .edition-price {
      shrink: 0;
      text-align: right;
      font-weight: 700;
      color: var(--forest);
      white-space: nowrap;
    }
    .edition-price small {
      display: block;
      font-weight: 600;
      color: var(--muted);
      font-size: 0.72rem;
      margin-top: 2px;
    }
  </style>
  <script src="https://cdn-reach.hostinger.com/js/embed.js" is:inline></script>
</body>
</html>
