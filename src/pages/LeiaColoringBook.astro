---
// Dedicated landing page for the "Super Leia to the Rescue!" coloring &
// activity book (LogicManse Publishing) — a lead-magnet giveaway page for
// people who scan the QR code on the book's back cover.
//
// This page is intentionally self-contained (its own <head>/<body>, not
// wrapped in BaseLayout/Header/Footer) rather than using the site's shared
// Reelcase chrome, since Reelcase and the coloring book are two unrelated
// ventures aimed at completely different audiences. If you'd rather this
// page use the site's shared header/nav, that's a quick follow-up change.
//
// Route: this file's name controls the URL, so it lives at
// https://www.logicmanse.ca/LeiaColoringBook/
// A small static redirect file (public/LeiaColoringBook.html) also exists
// so the exact printed URL (no trailing slash) on the book's QR code and
// back cover always resolves here too.
import { BOOK_LINKS } from '../data/site';

const PAGE_TITLE = "Super Leia to the Rescue! | LogicManse";
const PAGE_DESCRIPTION =
  "A coloring & activity book inspired by a real dog named Leia — 30 coloring pages, mazes and word searches, with a free bonus color pack.";
const CANONICAL_URL = "https://www.logicmanse.ca/LeiaColoringBook/";

// Where this book is sold. Both URLs live in src/data/site.ts so there is
// one file to edit when a listing goes live; an empty string renders a
// non-clickable "Coming soon" chip instead of a dead link.
//
// NOTE on the funnel: the QR code on the book's back cover points here
// and promises the free bonus color pack, so the pack is described below
// as something every copy includes. It is not offered as a download
// button here on Ani's instruction.
const { etsy: ETSY_URL, amazon: AMAZON_URL } = BOOK_LINKS.leia;
---

<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESCRIPTION} />
  <link rel="canonical" href={CANONICAL_URL} />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESCRIPTION} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={CANONICAL_URL} />
  <meta property="og:image" content="/leia-coloring-book/backyard-illustration.jpg" />
</head>
<body>
  <div class="wrap">
    <div class="logo-row">
      <img class="logo-badge" src="/leia-coloring-book/badge-coloring-activity.png" alt="Coloring & Activity Books">
      <img class="logo-main" src="/leia-coloring-book/logo.png" alt="LogicManse">
    </div>

    <h1>Super Leia to the Rescue!</h1>
    <p class="sub">A coloring &amp; activity book inspired by a real dog — 30 coloring pages, mazes, and word searches.</p>

    <div class="card">
      <h2>Two ways to start</h2>
      <p class="card-sub">Print it at home today, or have the paperback delivered.</p>

      <div class="buys">
        {ETSY_URL ? (
          <a class="buy buy-primary" href={ETSY_URL} rel="noopener">
            <span class="buy-kind">Digital · instant download</span>
            <span class="buy-store">Buy on Etsy →</span>
          </a>
        ) : (
          <span class="buy buy-soon">
            <span class="buy-kind">Digital · instant download</span>
            <span class="buy-store">Etsy — coming soon</span>
          </span>
        )}

        {AMAZON_URL ? (
          <a class="buy buy-primary" href={AMAZON_URL} rel="noopener">
            <span class="buy-kind">Paperback · delivered</span>
            <span class="buy-store">Buy on Amazon →</span>
          </a>
        ) : (
          <span class="buy buy-soon">
            <span class="buy-kind">Paperback · delivered</span>
            <span class="buy-store">Amazon — coming soon</span>
          </span>
        )}
      </div>

      <div class="included">
        <p class="included-title">Every copy includes a free bonus color pack</p>
        <ul class="features">
          <li>Full-color reference images for all 30 coloring pages, matched page-by-page to your book</li>
          <li>Real bonus photos of Leia — the actual dog who inspired the story</li>
          <li>The complete answer key for every maze, word search, and puzzle</li>
          <li>A behind-the-scenes note from the author</li>
        </ul>
      </div>
    </div>

    <div class="gallery">
      <figure class="ph-portrait"><img src="/leia-coloring-book/poster-leia-coloring-adventure.jpg" alt="Leia's Coloring Adventure poster"></figure>
      <figure class="ph-landscape"><img src="/leia-coloring-book/backyard-illustration.jpg" alt="Leia's backyard, illustrated"></figure>
    </div>

    <footer>
      Written by @Antz · A LogicManse Publication<br>
      <a href="/">logicmanse.ca</a>
    </footer>
  </div>

  <style>
    :root {
      --pink: #e67896;
      --pink-light: #fae1e8;
      --green: #1f6f4a;
      --black: #000000;
      --text: #333333;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      color: var(--text);
      background: linear-gradient(180deg, var(--pink-light) 0%, #ffffff 380px);
    }
    .wrap { max-width: 720px; margin: 0 auto; padding: 40px 24px 80px; }
    .logo-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 36px; flex-wrap: wrap; }
    .logo-row img { display: block; width: auto; }
    .logo-row .logo-badge { height: 52px; }
    .logo-row .logo-main { height: 48px; }
    h1 {
      text-align: center;
      font-size: 2.2rem;
      line-height: 1.2;
      color: #c8325a;
      margin: 0 0 10px;
    }
    .sub {
      text-align: center;
      font-size: 1.15rem;
      font-style: italic;
      color: #666;
      margin: 0 0 36px;
    }
    .card {
      background: #fff;
      border: 2px solid var(--pink);
      border-radius: 22px;
      padding: 32px 28px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.06);
      margin-bottom: 36px;
    }
    /* Gallery: the poster (tall/portrait) and the backyard illustration
       (wide/landscape) have very different native shapes. Rather than
       forcing both into one aspect-ratio box (which crops the landscape
       image down to a sliver), each figure keeps its own true aspect
       ratio and they're aligned by a shared height instead — like two
       different-shaped photos laid side by side, not a rigid grid. */
    .gallery {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .gallery figure {
      margin: 0;
      height: 240px;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(0,0,0,0.10);
      background: #f2f2f2;
    }
    .gallery figure.ph-portrait { aspect-ratio: 700 / 1244; }
    .gallery figure.ph-landscape { aspect-ratio: 1000 / 563; }
    .gallery img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      display: block;
    }
    @media (max-width: 480px) {
      .gallery { gap: 10px; }
      .gallery figure { height: 150px; }
    }
    .card h2 {
      margin-top: 0;
      font-size: 1.3rem;
      color: #333;
    }
    ul.features {
      list-style: none;
      padding: 0;
      margin: 20px 0 30px;
    }
    ul.features li {
      padding: 10px 0 10px 34px;
      position: relative;
      font-size: 1.02rem;
      border-bottom: 1px solid #f2f2f2;
    }
    ul.features li:last-child { border-bottom: none; }
    ul.features li::before {
      content: "🐾";
      position: absolute;
      left: 0;
      top: 9px;
    }
    .card-sub { color: #666; line-height: 1.5; margin: 8px 0 0; }

    /* Two storefronts, equal weight — a book someone prints at home
       tonight and a book that arrives in the post are different products
       to different buyers, so neither is the "real" one. */
    .buys {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 22px 0 4px;
    }
    .buy {
      display: flex;
      flex-direction: column;
      gap: 5px;
      text-align: center;
      padding: 16px 18px;
      border-radius: 14px;
      text-decoration: none;
    }
    .buy-kind {
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      opacity: 0.8;
    }
    .buy-store { font-size: 1.05rem; font-weight: 700; line-height: 1.2; }

    .buy-primary {
      background: var(--pink);
      color: #fff !important;
      transition: transform 0.1s ease, background 0.15s ease;
    }
    .buy-primary:hover { background: #d85f80; transform: translateY(-1px); }

    /* Not on sale yet. Deliberately a <span>, not a disabled-looking
       link — there is nothing to click, and saying so plainly beats a
       button that swallows a tap. */
    .buy-soon {
      background: var(--pink-light);
      border: 1px dashed var(--pink);
      color: #a3808b;
      cursor: default;
    }

    .included {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid #f2f2f2;
    }
    .included-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--green);
      margin: 0;
    }
    .included .features { margin-bottom: 0; }

    @media (max-width: 480px) {
      .buys { grid-template-columns: 1fr; }
    }

    footer {
      text-align: center;
      margin-top: 50px;
      padding-top: 26px;
      border-top: 1px solid #eee;
      font-size: 0.9rem;
      color: #777;
    }
    footer a { color: var(--green); text-decoration: none; font-weight: 600; }
  </style>
</body>
</html>
