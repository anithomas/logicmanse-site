---
import { REACH_FORMS } from '../data/site';
import QrLogo from '../components/QrLogo.astro';
import '../styles/qr-brand.css';
// Dedicated landing page for the "Super Leia to the Rescue!" coloring &
// activity book (LogicManse Publishing) — a lead-magnet giveaway page for
// people who scan the QR code on the book's back cover.
//
// THIS IS THE QR-CODE PAGE, NOT THE PRODUCT PAGE. It exists to hand the
// free bonus to somebody who already owns the book and has just scanned
// the code in the back of it. The page that SELLS the book is
// src/pages/books/leia-coloring-book.astro — keep the two separate, and never
// put a buy button here: this reader has already bought.
//
// This page is intentionally self-contained (its own <head>/<body>, not
// wrapped in BaseLayout/Header/Footer) rather than using the site's shared
// Reelcase chrome, since Reelcase and the coloring book are two unrelated
// ventures aimed at completely different audiences. If you'd rather this
// page use the site's shared header/nav, that's a quick follow-up change.
//
// Route: this file's name controls the URL, so it lives at
// https://www.logicmanse.ca/LeiaColoringBook/
// A small static redirect file (public/LeiaColoringBook.html) also exists
// so the exact printed URL (no trailing slash) on the book's QR code and
// back cover always resolves here too.
const PAGE_TITLE = "Your Free Bonus — Leia's Color Pack | LogicManse";
const PAGE_DESCRIPTION =
  "Get Leia's free bonus color pack: full-color reference pages, real photos, and the answer key for Super Leia to the Rescue!";
const CANONICAL_URL = "https://www.logicmanse.ca/LeiaColoringBook/";
const REACH_FORM_URL = REACH_FORMS.leia;
---

<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESCRIPTION} />
  <link rel="canonical" href={CANONICAL_URL} />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESCRIPTION} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={CANONICAL_URL} />
  <meta property="og:image" content="/leia-coloring-book/backyard-illustration.jpg" />
  <!-- Brand type: Merriweather headings, Inter body — same as the site. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="wrap">
    <QrLogo />

    <p class="eyebrow">You've got the book — here's the bonus</p>
    <h1>Leia's Free Bonus Color Pack</h1>
    <p class="sub">
      Thanks for picking up <em>Super Leia to the Rescue!</em> The bonus pack is yours — real
      photos, full-color reference pages, and every puzzle answer.
    </p>

    <div class="card">
      <h2>What's inside:</h2>
      <ul class="features">
        <li>Full-color reference images for all 30 coloring pages, matched page-by-page to your book</li>
        <li>Real bonus photos of Leia — the actual dog who inspired the story</li>
        <li>The complete answer key for every maze, word search, and puzzle</li>
        <li>A behind-the-scenes note from the author</li>
      </ul>

      <a class="cta" href={REACH_FORM_URL}>Send Me the Color Pack →</a>
      <p class="fineprint">Takes 10 seconds. We'll email you the link right away.</p>
    </div>

    <div class="gallery">
      <figure class="ph-portrait"><img src="/leia-coloring-book/poster-leia-coloring-adventure.jpg" alt="Leia's Coloring Adventure poster"></figure>
      <figure class="ph-landscape"><img src="/leia-coloring-book/backyard-illustration.jpg" alt="Leia's backyard, illustrated"></figure>
    </div>

    <p class="hint">
      Haven't got the book yet? <a href="/books/leia-coloring-book/">See where to buy it →</a>
    </p>

    <footer>
      Written by @Antz · A LogicManse Publication<br>
      <a href="/">logicmanse.ca</a>
    </footer>
  </div>

  <style>
    /* Page-specific only — the brand look is in src/styles/qr-brand.css. */
    .gallery figure.ph-portrait { aspect-ratio: 700 / 1244; }
    .gallery figure.ph-landscape { aspect-ratio: 1000 / 563; }
    @media (max-width: 480px) { .gallery figure { height: 150px; } }
  </style>
</body>
</html>
