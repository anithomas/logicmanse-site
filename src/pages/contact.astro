---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

// ----------------------------------------------------------------
// REAL FORM SUBMISSIONS (Ani — read this before going live):
// This form posts to Formspree, a free form-backend service — no
// server or code needed on your end, and no third-party JS library
// either. Submissions land in your inbox and in a dashboard at
// formspree.io.
//
// 1. Go to https://formspree.io and sign up free with your
//    info@logicmanse.ca address.
// 2. Create a new form, verify the email Formspree sends you.
// 3. Copy the form endpoint it gives you (looks like
//    https://formspree.io/f/abcdwxyz) and paste it below, replacing
//    FORMSPREE_ENDPOINT.
// Until you do that, this form will not actually deliver anywhere —
// it will show a Formspree error page saying the endpoint isn't real.
// ----------------------------------------------------------------
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/YOUR_FORM_ID';
---

<BaseLayout
  title="Get Early Access"
  description="Get early access to Reelcase — a cinematic portfolio for your UGC takes. Tell us about your work and we'll be in touch."
>
  <div class="reelcase">
    <section class="relative overflow-hidden grain">
      <div class="max-w-4xl mx-auto px-6 py-20 text-center relative">
        <p class="timecode uppercase tracking-widest text-xs md:text-sm mb-4">Early Access — Take 01</p>
        <h1 class="fade-in-up font-display uppercase text-print text-4xl md:text-5xl tracking-wide mb-4">
          Get Your Slate
        </h1>
        <p class="fade-in-up text-lg text-print/70 max-w-2xl mx-auto font-body">
          Tell us about the takes you've already got and the brands you want to work with. We'll
          reach out to help you cut your first Reelcase portfolio.
        </p>
      </div>
    </section>

    <section>
      <div class="max-w-2xl mx-auto px-6 pb-24">
        <form
          action={FORMSPREE_ENDPOINT}
          method="POST"
          class="fade-in-up space-y-6 bg-negative border border-white/10 rounded-xl p-8"
        >
          <input type="hidden" name="_subject" value="Reelcase Early Access Request" />
          <input type="hidden" name="_next" value="/thank-you/" />

          <div>
            <label for="name" class="block text-sm font-semibold text-print mb-1 font-mono uppercase tracking-wide">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-reel border border-white/10 rounded-md px-4 py-3 text-print focus:outline-none focus:ring-2 focus:ring-tungsten"
            />
          </div>

          <div>
            <label for="handle" class="block text-sm font-semibold text-print mb-1 font-mono uppercase tracking-wide">TikTok / Instagram Handle</label>
            <input
              type="text"
              id="handle"
              name="handle"
              placeholder="@yourhandle"
              class="w-full bg-reel border border-white/10 rounded-md px-4 py-3 text-print placeholder:text-ash focus:outline-none focus:ring-2 focus:ring-tungsten"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-print mb-1 font-mono uppercase tracking-wide">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-reel border border-white/10 rounded-md px-4 py-3 text-print focus:outline-none focus:ring-2 focus:ring-tungsten"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-print mb-1 font-mono uppercase tracking-wide">
              What kind of takes do you make — and what's holding your portfolio back right now?
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full bg-reel border border-white/10 rounded-md px-4 py-3 text-print focus:outline-none focus:ring-2 focus:ring-tungsten"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-tungsten hover:bg-tungsten-light text-reel font-display uppercase tracking-wide px-8 py-4 rounded-sm transition-colors"
          >
            Request Early Access
          </button>

          <p class="text-xs text-ash text-center font-mono">
            Submitted directly and securely via Formspree, our form-delivery provider — nothing
            opens in a separate app. Your information is never sold or shared.
          </p>
        </form>

        <p class="fade-in-up text-center text-print/60 text-sm mt-8 font-body">
          Prefer to email directly? Reach us at{' '}
          <a href={`mailto:${SITE.contactEmail}`} class="text-tungsten font-semibold hover:underline">
            {SITE.contactEmail}
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
