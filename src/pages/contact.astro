---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

// ----------------------------------------------------------------
// Contact form: Hostinger Reach's official embed — the loader script
// plus <div data-reach-form="...">, as Reach's dashboard issues it.
// (It replaced a Formspree form whose endpoint was never configured and
// silently discarded every message.)
//
// How the loader behaves, from reading it: it builds an iframe pointing
// at reach-forms.hostingerusercontent.com inside the div, and sets the
// iframe's height when the form inside posts a `reach:resize` message.
// It also counts a view and a submit via a beacon, deduping the view
// with a localStorage key — disclosed in the privacy policy; keep the
// two in step if this embed changes.
//
// THE LOADING STATE, and why it exists. The embed script and the frame
// both arrive in well under a second, but the form inside is a small app
// that has to boot before it paints anything or reports its height. Until
// then this page used to show an empty white 400px box — which reads as
// broken, and was reported as broken. So now:
//   - the host shows a visible "Loading the contact form…" placeholder,
//     and the frame stays out of sight until it has reported a real
//     height, so nobody is ever looking at a blank rectangle;
//   - after 6s with no form, the placeholder offers a direct link to the
//     form and the email address — for a slow embed, or a content blocker
//     that has stopped Hostinger's script outright;
//   - after 20s with still no real height ever reported, the placeholder
//     switches to a definite "this form isn't loading right now" message
//     (same link + email) instead of spinning forever. It does NOT force
//     a guessed height and reveal the iframe anyway — live testing showed
//     that in this failure mode the form's own content can genuinely be
//     empty, so revealing it just trades a labeled placeholder for an
//     unlabeled blank box, which is worse.
//   - the host keeps watching even after it goes ready, because Reach's
//     own boot sequence can report a real height and then report 0 again
//     moments later (see the long comment in the script below); if that
//     happens the placeholder/fallback comes back instead of leaving an
//     empty box on screen.
// With JavaScript off the loader never runs, and the placeholder's link
// and email address are what remains — the right fallback.
// ----------------------------------------------------------------
const REACH_FORM_ID = '5e71aa5d-e0c2-4f63-a878-7c6dc04f88b9';
const REACH_FORM_URL = `https://reach-forms.hostingerusercontent.com/form/${REACH_FORM_ID}`;
const REACH_EMBED_SCRIPT = 'https://cdn-reach.hostinger.com/js/embed.js';

const MAILTO = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(
  'Question for LogicManse Publications'
)}`;
---

<BaseLayout
  title="Contact"
  description="Get in touch with LogicManse Publications — questions about a book, bulk orders, or an idea for a title that doesn't exist yet."
>
  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-5xl mb-4 text-white">Get in Touch</h1>
      <p class="fade-in-up text-lg text-white/80 max-w-2xl mx-auto">
        A question about one of our books, a bulk order, or an idea for a title that doesn't exist
        yet — tell us about it. We'll reply within one business day.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-2xl mx-auto px-6 py-20 space-y-10">
      {/* Full-bleed on mobile (-mx-6 cancels the section's px-6): the form
          brings its own padding, and nesting it inside the section's padding
          too wastes width twice over on a phone. The card returns from sm up.
          The form is responsive down to 320px — verified by narrowing the
          frame to 360 real CSS pixels and watching it reflow. */}
      <div class="fade-in-up -mx-6 sm:mx-0 sm:border sm:border-slate-200 sm:rounded-xl overflow-hidden">
        <div class="reach-host" data-reach-form={REACH_FORM_ID}>
          <div class="reach-placeholder">
            <span class="reach-spinner" aria-hidden="true"></span>
            <p class="reach-loading-text">Loading the contact form…</p>
            <p class="reach-failed-text">This form isn't loading right now.</p>
            <p class="reach-slow">
              Taking a while?
              <a href={REACH_FORM_URL} target="_blank" rel="noopener">Open the form in a new tab</a>
              or email <a href={MAILTO}>{SITE.contactEmail}</a>.
            </p>
          </div>
        </div>
      </div>

      <div class="fade-in-up bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
        <h2 class="text-2xl font-serif font-bold text-navy mb-3">Prefer email?</h2>
        <p class="text-slate-600 leading-relaxed mb-7 max-w-md mx-auto">
          Write to us directly — the same inbox as the form, and the same one-business-day reply.
        </p>
        <a
          href={MAILTO}
          class="inline-block bg-forest hover:bg-forest-light text-white font-semibold px-8 py-4 rounded-md transition-colors"
        >
          {SITE.contactEmail}
        </a>
        <p class="text-xs text-slate-400 mt-6">
          Opens your email app. Your address is never sold or shared.
        </p>
      </div>
    </div>
  </section>

  <script>
    // Watches the Reach host and flips it through states — loading, slow,
    // ready, failed. See the note at the top of this file for why the
    // loading state exists at all.
    const host = document.querySelector<HTMLElement>('.reach-host');
    if (host) {
      host.dataset.js = '';
      const frame = () => host.querySelector<HTMLIFrameElement>('iframe');
      // Second bug found live 16 Sep 2026, after the first (a truthy-string
      // check accepting an early "0px" as final — fixed below by requiring
      // h > 0). Live stress-testing that fix showed the form still went
      // permanently blank on a meaningful fraction of loads, with `ready`
      // true and the iframe's own height string reading "0px" — a state
      // the h>0 check alone cannot produce. Root cause: Reach's own script
      // can report a real positive height and then *independently* report
      // 0 again later in the same boot sequence (its app re-measuring
      // before its content has actually painted). The previous code
      // disconnected its MutationObserver the instant it first saw h > 0,
      // so that later 0 went unnoticed and the form stayed hidden with
      // nothing on screen — the exact blank-box failure this file exists
      // to prevent. Direct requests to the Reach form URL itself return
      // fast and clean every time, so this is Reach's client-side app
      // racing itself, not a network or server failure — nothing further
      // upstream can be fixed from here. Now: never disconnect, so a later
      // drop back to 0 un-readies the host and re-shows the fallback
      // instead of leaving an empty box; and after 20s with no positive
      // height ever observed, mark the host failed so the "open directly /
      // email us" message is shown for certain, rather than spinning
      // forever on a form that may never boot.
      let everReady = false;
      const check = () => {
        const f = frame();
        const h = f ? parseFloat(f.style.height) : 0;
        if (h > 0) {
          everReady = true;
          host.dataset.ready = '';
          delete host.dataset.failed;
        } else if (everReady) {
          delete host.dataset.ready;
        }
      };
      const observer = new MutationObserver(() => check());
      observer.observe(host, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['style'],
      });
      check();

      setTimeout(() => {
        if (!everReady) host.dataset.slow = '';
      }, 6000);

      setTimeout(() => {
        if (!everReady) host.dataset.failed = '';
      }, 20000);
    }
  </script>

  <style>
    .reach-host {
      position: relative;
      background: #f8fafc;
    }
    .reach-host:not([data-ready]) {
      min-height: 420px;
    }
    .reach-host[data-ready] {
      background: transparent;
    }
    .reach-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 2rem;
      text-align: center;
      color: #475569;
      font-size: 0.95rem;
    }
    .reach-host[data-ready] .reach-placeholder {
      display: none;
    }
    .reach-spinner {
      display: none;
      width: 28px;
      height: 28px;
      border-radius: 9999px;
      border: 3px solid #cbd5e1;
      border-top-color: #1f6f4a;
      animation: reach-spin 0.9s linear infinite;
    }
    .reach-host[data-js]:not([data-ready]):not([data-failed]) .reach-spinner {
      display: block;
    }
    .reach-failed-text {
      display: none;
      font-weight: 600;
      color: #334155;
    }
    .reach-host[data-failed] .reach-loading-text {
      display: none;
    }
    .reach-host[data-failed] .reach-failed-text {
      display: block;
    }
    .reach-slow {
      font-size: 0.85rem;
      color: #64748b;
      max-width: 26rem;
    }
    /* Hidden only once JS is confirmed running; without JS the loader never
       runs either, so the link has to be visible from the start. */
    .reach-host[data-js]:not([data-slow]) .reach-slow {
      display: none;
    }
    .reach-slow a {
      color: #1f6f4a;
      font-weight: 600;
      text-decoration: underline;
    }
    /* Out of sight but full width until the form reports its height: a
       collapsed or 1px-wide frame would make it measure itself wrong. */
    .reach-host:not([data-ready]) :global(iframe) {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      opacity: 0;
      pointer-events: none;
    }
    @keyframes reach-spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .reach-spinner {
        animation: none;
      }
    }
  </style>

  <script is:inline src={REACH_EMBED_SCRIPT} defer></script>
</BaseLayout>
