---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

// ----------------------------------------------------------------
// REAL FORM SUBMISSIONS (Ani — read this before going live):
// This form posts to Formspree, a free form-backend service — no
// server or code needed on your end, and no third-party JS library
// either. Submissions land in your inbox and in a dashboard at
// formspree.io.
//
// 1. Go to https://formspree.io and sign up free with your
//    info@logicmanse.ca address.
// 2. Create a new form, verify the email Formspree sends you.
// 3. Copy the form endpoint it gives you (looks like
//    https://formspree.io/f/abcdwxyz) and paste it below.
//
// UNTIL YOU DO, THE FORM IS NOT RENDERED AT ALL, on purpose. The
// placeholder endpoint below is not a real Formspree form — posting to
// it returns 404, which meant every message someone typed into this
// page was silently thrown away, and they were shown an error page
// instead of a reply. A contact page that loses mail is worse than one
// with no form, so while the endpoint is unset this page shows the
// email address as the way to reach you. info@logicmanse.ca has live
// MX records, so that route genuinely works today.
//
// Paste a real endpoint and the form comes back on the next build.
// ----------------------------------------------------------------
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/YOUR_FORM_ID';

// Guard against shipping the placeholder: anything still containing
// YOUR_FORM_ID (or empty) counts as "not configured yet".
const FORM_IS_LIVE =
  Boolean(FORMSPREE_ENDPOINT) && !FORMSPREE_ENDPOINT.includes('YOUR_FORM_ID');

const MAILTO = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(
  'Question for Logicmanse Solutions'
)}`;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Logicmanse Solutions — questions about a book, bulk orders, or an idea for a title that doesn't exist yet."
>
  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-5xl mb-4 text-white">Get in Touch</h1>
      <p class="fade-in-up text-lg text-white/80 max-w-2xl mx-auto">
        A question about one of our books, a bulk order, or an idea for a title that doesn't exist
        yet — tell us about it. We'll reply within one business day.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-2xl mx-auto px-6 py-20">
      {FORM_IS_LIVE ? (
      <form
        action={FORMSPREE_ENDPOINT}
        method="POST"
        class="fade-in-up space-y-6 bg-slate-50 border border-slate-200 rounded-xl p-8"
      >
        <input type="hidden" name="_subject" value="Website Contact Form Submission" />
        <input type="hidden" name="_next" value="/thank-you/" />

        <div>
          <label for="name" class="block text-sm font-semibold text-navy mb-1">Your Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full border border-slate-300 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-forest"
          />
        </div>

        <div>
          <label for="business" class="block text-sm font-semibold text-navy mb-1">Business / Organization (optional)</label>
          <input
            type="text"
            id="business"
            name="business"
            class="w-full border border-slate-300 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-forest"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-navy mb-1">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-slate-300 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-forest"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-navy mb-1">
            What can we help with?
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full border border-slate-300 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-forest"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-forest hover:bg-forest-light text-white font-semibold px-8 py-4 rounded-md transition-colors"
        >
          Send Message
        </button>

        <p class="text-xs text-slate-400 text-center">
          Submitted directly and securely via Formspree, our form-delivery provider — nothing
          opens in a separate app. Your information is never sold or shared.
        </p>
      </form>
      ) : (
      <div class="fade-in-up bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
        <h2 class="text-2xl font-serif font-bold text-navy mb-3">Email us directly</h2>
        <p class="text-slate-600 leading-relaxed mb-7 max-w-md mx-auto">
          We read every message ourselves, and we'll reply within one business day. Tell us the
          book or the question and we'll take it from there.
        </p>
        <a
          href={MAILTO}
          class="inline-block bg-forest hover:bg-forest-light text-white font-semibold px-8 py-4 rounded-md transition-colors"
        >
          {SITE.contactEmail}
        </a>
        <p class="text-xs text-slate-400 mt-6">
          Opens your email app. Your address is never sold or shared.
        </p>
      </div>
      )}

      {FORM_IS_LIVE && (
        <p class="fade-in-up text-center text-slate-500 text-sm mt-8">
          Prefer to email directly? Reach us at{' '}
          <a href={MAILTO} class="text-forest font-semibold hover:underline">
            {SITE.contactEmail}
          </a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>
