---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

// ----------------------------------------------------------------
// The Formspree form that used to live here is gone. It posted to the
// never-replaced placeholder endpoint (/f/YOUR_FORM_ID), which 404s,
// so every message typed into this page was silently thrown away.
//
// In its place: Reach's official embed — the loader script plus the
// <div data-reach-form="...">, exactly as Reach's dashboard issues it.
//
// What the loader does, having read it: it finds the div, builds the
// iframe itself pointing at reach-forms.hostingerusercontent.com, and
// then listens for a `reach:resize` postMessage from inside the form to
// set the iframe's height. That auto-sizing is the reason to use the
// official embed over a hand-rolled iframe — the height follows the
// form through validation errors and the success state instead of being
// a number guessed here that goes stale the moment the form is edited
// in Reach. It also counts a view (once the div is 50% on screen) and a
// submit, via a beacon to /api/v1/forms/<id>/impression, and dedupes
// the view for 30 minutes using a localStorage key. That is disclosed
// in the privacy policy — keep the two in step if this embed changes.
//
// MIN_HEIGHT only reserves space until the first resize message lands,
// so the page doesn't jump as the form settles. It is a floor on the
// wrapper, not a cap on the frame: the form measures 392px at desktop
// width and taller on a phone, and the loader sets the real height when
// it arrives. Keep it just under the settled height, or the difference
// shows as dead space under the form forever.
// ----------------------------------------------------------------
const REACH_FORM_ID = '5e71aa5d-e0c2-4f63-a878-7c6dc04f88b9';
const REACH_EMBED_SCRIPT = 'https://cdn-reach.hostinger.com/js/embed.js';
const MIN_HEIGHT = 400;

const MAILTO = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(
  'Question for Logicmanse Solutions'
)}`;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Logicmanse Solutions — questions about a book, bulk orders, or an idea for a title that doesn't exist yet."
>
  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-5xl mb-4 text-white">Get in Touch</h1>
      <p class="fade-in-up text-lg text-white/80 max-w-2xl mx-auto">
        A question about one of our books, a bulk order, or an idea for a title that doesn't exist
        yet — tell us about it. We'll reply within one business day.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-2xl mx-auto px-6 py-20 space-y-10">
      <!-- Reach form: new-release list signup. -->
      <!-- White, not slate: the Reach form paints its own white
           background, so any height slack would otherwise show as a
           coloured band under the submit button.
           Full-bleed on mobile (-mx-6 cancels the section's px-6). Not a
           workaround — the form is responsive down to 320px, verified by
           narrowing the frame to 360 real CSS pixels and watching it
           reflow and re-report its height. It goes edge-to-edge simply
           because the form brings its own generous padding, and nesting
           that inside the section's padding wastes width twice over on a
           phone. At sm and up there is room for both, and the card
           returns. -->
      <div class="fade-in-up -mx-6 sm:mx-0 bg-white sm:border sm:border-slate-200 sm:rounded-xl overflow-hidden">
        <div data-reach-form={REACH_FORM_ID} style={`min-height:${MIN_HEIGHT}px`}></div>
      </div>

      <!-- The actual contact route. The Reach form above collects a name
           and an email for the mailing list; it has no message field, so
           a question needs somewhere else to go. -->
      <div class="fade-in-up bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
        <h2 class="text-2xl font-serif font-bold text-navy mb-3">Got a question?</h2>
        <p class="text-slate-600 leading-relaxed mb-7 max-w-md mx-auto">
          Email us and we'll reply within one business day. Bulk orders, a question about one of
          the books, or an idea for a title that doesn't exist yet — we read every message
          ourselves.
        </p>
        <a
          href={MAILTO}
          class="inline-block bg-forest hover:bg-forest-light text-white font-semibold px-8 py-4 rounded-md transition-colors"
        >
          {SITE.contactEmail}
        </a>
        <p class="text-xs text-slate-400 mt-6">
          Opens your email app. Your address is never sold or shared.
        </p>
      </div>
    </div>
  </section>
  <script is:inline src={REACH_EMBED_SCRIPT} defer></script>
</BaseLayout>
