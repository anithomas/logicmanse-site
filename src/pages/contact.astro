---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

// ----------------------------------------------------------------
// The Formspree form that used to live here is gone. It posted to the
// never-replaced placeholder endpoint (/f/YOUR_FORM_ID), which 404s,
// so every message typed into this page was silently thrown away.
//
// In its place: the Reach form Ani supplied, embedded, plus a direct
// email route.
//
// WHY AN IFRAME, not the <div data-reach-form="..."> snippet: that div
// is only half of Reach's embed code — it does nothing without the
// loader script that hydrates it, and Reach's dashboard issues that
// script alongside the div. Only the div was to hand, and the loader's
// URL isn't published (the standalone form bundle doesn't serve it).
// The form page itself sends `content-security-policy: frame-ancestors *`,
// so framing it is explicitly supported and works today with nothing to
// discover. If the `<script src="...">` line turns up later, swapping to
// the official embed is a small change and buys automatic height
// resizing.
//
// FORM_HEIGHT is measured from the live form (392px of content) plus
// slack for the success state and for a validation message under a
// field. The iframe scrolls if it ever needs more, so a Reach-side edit
// can't clip the submit button.
const REACH_CONTACT_FORM = 'https://reach-forms.hostingerusercontent.com/form/5e71aa5d-e0c2-4f63-a878-7c6dc04f88b9';
const FORM_HEIGHT = 460;

const MAILTO = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(
  'Question for Logicmanse Solutions'
)}`;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Logicmanse Solutions — questions about a book, bulk orders, or an idea for a title that doesn't exist yet."
>
  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="fade-in-up font-serif font-bold text-4xl md:text-5xl mb-4 text-white">Get in Touch</h1>
      <p class="fade-in-up text-lg text-white/80 max-w-2xl mx-auto">
        A question about one of our books, a bulk order, or an idea for a title that doesn't exist
        yet — tell us about it. We'll reply within one business day.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-2xl mx-auto px-6 py-20 space-y-10">
      <!-- Reach form: new-release list signup. -->
      <!-- White, not slate: the Reach form paints its own white
           background, and the height slack below it would otherwise show
           as a coloured band under the submit button.
           Full-bleed on mobile (-mx-6 cancels the section's px-6): inside
           a frame the form lays itself out against the device width, not
           the iframe's, so anything narrower than the screen clips its
           right-hand edge — the heading and the submit button first. At
           sm and up there is room to spare, and the card returns.
           overflow-hidden is also held back to sm: at mobile widths the
           frame keeps its own scrollbars, so if the form still lays out
           wider than the phone, the fields stay reachable instead of
           being cropped away. -->
      <div class="fade-in-up -mx-6 sm:mx-0 bg-white sm:border sm:border-slate-200 sm:rounded-xl sm:overflow-hidden">
        <iframe
          src={REACH_CONTACT_FORM}
          title="Join the Logicmanse mailing list"
          loading="lazy"
          height={FORM_HEIGHT}
          class="w-full block border-0"
        ></iframe>
      </div>

      <!-- The actual contact route. The Reach form above collects a name
           and an email for the mailing list; it has no message field, so
           a question needs somewhere else to go. -->
      <div class="fade-in-up bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
        <h2 class="text-2xl font-serif font-bold text-navy mb-3">Got a question?</h2>
        <p class="text-slate-600 leading-relaxed mb-7 max-w-md mx-auto">
          Email us and we'll reply within one business day. Bulk orders, a question about one of
          the books, or an idea for a title that doesn't exist yet — we read every message
          ourselves.
        </p>
        <a
          href={MAILTO}
          class="inline-block bg-forest hover:bg-forest-light text-white font-semibold px-8 py-4 rounded-md transition-colors"
        >
          {SITE.contactEmail}
        </a>
        <p class="text-xs text-slate-400 mt-6">
          Opens your email app. Your address is never sold or shared.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
