---
// This page was the "Trust & Security" page for the pre-pivot
// retail-software business (see git history if you ever need that
// content back). Kept as a redirect, not deleted outright, so old
// bookmarks/search results don't dead-end in a 404. Redirects to
// Privacy Policy rather than Books since its subject (data handling)
// is the closer match.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Trust & Security" description="See our Privacy Policy at /privacy-policy/.">
  <meta http-equiv="refresh" content="0; url=/privacy-policy/" />
  <section class="bg-white">
    <div class="max-w-2xl mx-auto px-6 py-24 text-center">
      <p class="text-slate-600">
        This page has moved — redirecting you to our
        <a href="/privacy-policy/" class="text-forest font-semibold hover:underline">Privacy Policy</a>.
      </p>
    </div>
  </section>
</BaseLayout>
