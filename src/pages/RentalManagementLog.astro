---
// Dedicated landing page for the "Rental Property Record Book" (LogicManse
// Publications) — a lead-magnet giveaway page for the free companion
// digital rental tracker, same funnel pattern as LeiaColoringBook.astro.
//
// Palette and tone deliberately differ from Leia's page: this book's own
// design brief (Rental_Property_Log_Blueprint.md, LogicManse Publications
// Book Blueprint No. 01) calls for "a different visual register from Leia
// on purpose — this is a business tool, not a children's book." Colors
// below (forest ink / bone paper / brass / ledger teal) are taken directly
// from that blueprint's §04 cover design brief, not reused from Leia.
//
// This page is self-contained (its own <head>/<body>, not the main site's
// BaseLayout/Header/Footer), same reasoning as Leia's page: this is an
// unrelated venture from the Logicmanse Solutions software business.
//
// Gallery images come straight from the finished production files: the
// cover is the front panel of Rental_Property_Record_Book_COVER.pdf
// rendered at its trim box (NOT the Book Bolt re-processed export, which
// double-pads the bleed — see the blueprint's §08 defect note), and the
// interior shot is the monthly income & expense tracker.
//
// Route: this file's name controls the URL, so it lives at
// https://www.logicmanse.ca/RentalManagementLog/
// A small static redirect file (public/RentalManagementLog.html) also
// exists so the exact URL (no trailing slash) always lands on this real
// page too, regardless of how GitHub Pages resolves that ambiguity.
import { BOOK_LINKS } from '../data/site';

const PAGE_TITLE = 'Rental Property Record Book | LogicManse Publications';
const PAGE_DESCRIPTION =
  'A 109-page undated record book for a landlord with 1-6 properties — rent, tenants and leases, maintenance, mileage and a year-end summary, with a free companion spreadsheet.';
const CANONICAL_URL = 'https://www.logicmanse.ca/RentalManagementLog/';

// Where this book is sold. Both URLs live in src/data/site.ts so there is
// one file to edit when a listing goes live; an empty string renders a
// non-clickable "Coming soon" chip instead of a dead link.
//
// NOTE on the funnel: page 108 of the printed book carries a QR code and
// this URL next to the promise of a free digital companion, so the
// companion is described below as something every copy includes. It is
// not offered as a download button here on Ani's instruction.
const { etsy: ETSY_URL, amazon: AMAZON_URL } = BOOK_LINKS.rentalLog;
---

<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESCRIPTION} />
  <link rel="canonical" href={CANONICAL_URL} />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESCRIPTION} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={CANONICAL_URL} />
</head>
<body>
  <div class="wrap">
    <div class="logo-row">
      <img src="/rental-management-log/logo.png" alt="LogicManse">
    </div>

    <h1>Rental Property Record Book</h1>
    <p class="sub">
      Built for a landlord managing 1–6 properties, not a property-management firm —
      109 undated pages for a full year of real use.
    </p>

    <div class="card">
      <h2>Two ways to start</h2>
      <p class="card-sub">
        Print it at home today, or have the paperback delivered. Same 109 pages either way.
      </p>

      <div class="buys">
        {ETSY_URL ? (
          <a class="buy buy-primary" href={ETSY_URL} rel="noopener">
            <span class="buy-kind">Digital · instant download</span>
            <span class="buy-store">Buy on Etsy →</span>
          </a>
        ) : (
          <span class="buy buy-soon">
            <span class="buy-kind">Digital · instant download</span>
            <span class="buy-store">Etsy — coming soon</span>
          </span>
        )}

        {AMAZON_URL ? (
          <a class="buy buy-primary" href={AMAZON_URL} rel="noopener">
            <span class="buy-kind">Paperback · delivered</span>
            <span class="buy-store">Buy on Amazon →</span>
          </a>
        ) : (
          <span class="buy buy-soon">
            <span class="buy-kind">Paperback · delivered</span>
            <span class="buy-store">Amazon — coming soon</span>
          </span>
        )}
      </div>

      <div class="included">
        <p class="included-title">Every copy includes a free companion spreadsheet</p>
        <ul class="features">
          <li>A 12-month rent payment tracker, ready to use for up to 6 properties</li>
          <li>A tenant &amp; lease log with every renewal date in one place, so nothing sneaks up on you</li>
          <li>A monthly income &amp; expense tracker built with tax time in mind</li>
          <li>A vendor &amp; contractor directory template, organized by trade</li>
        </ul>
      </div>
    </div>

    <div class="gallery">
      <figure class="ph-portrait">
        <img src="/rental-management-log/cover-front.jpg" alt="Rental Property Record Book cover" />
      </figure>
      <figure class="ph-square">
        <img
          src="/rental-management-log/interior-page.jpg"
          alt="A sample interior page: the monthly income &amp; expense tracker"
        />
      </figure>
    </div>

    <footer>
      Written by @Antz · A LogicManse Publication<br>
      <a href="/">logicmanse.ca</a>
    </footer>
  </div>

  <style>
    :root {
      --forest: #1F3B36;
      --bone: #F4F1E6;
      --brass: #B08D4F;
      --teal: #2B5D63;
      --text: #333333;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      color: var(--text);
      background: linear-gradient(180deg, var(--bone) 0%, #ffffff 380px);
    }
    .wrap { max-width: 720px; margin: 0 auto; padding: 40px 24px 80px; }
    .logo-row { display: flex; align-items: center; justify-content: center; margin-bottom: 36px; }
    .logo-row img { height: 44px; }
    h1 {
      text-align: center;
      font-size: 2.2rem;
      line-height: 1.2;
      color: var(--forest);
      margin: 0 0 10px;
    }
    .sub {
      text-align: center;
      font-size: 1.15rem;
      font-style: italic;
      color: #666;
      margin: 0 0 36px;
    }
    .card {
      background: #fff;
      border: 2px solid var(--teal);
      border-radius: 22px;
      padding: 32px 28px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.06);
      margin-bottom: 36px;
    }
    .card h2 {
      margin-top: 0;
      font-size: 1.3rem;
      color: #333;
    }
    ul.features {
      list-style: none;
      padding: 0;
      margin: 20px 0 30px;
    }
    ul.features li {
      padding: 10px 0 10px 34px;
      position: relative;
      font-size: 1.02rem;
      border-bottom: 1px solid #f2f2f2;
    }
    ul.features li:last-child { border-bottom: none; }
    ul.features li::before {
      content: "\2022";
      color: var(--brass);
      font-weight: 700;
      position: absolute;
      left: 12px;
      top: 9px;
      font-size: 1.3rem;
      line-height: 1;
    }
    .card-sub { color: #666; line-height: 1.5; margin: 8px 0 0; }

    /* Two storefronts, equal weight — a book someone prints at home
       tonight and a book that arrives in the post are different products
       to different buyers, so neither is the "real" one. */
    .buys {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 22px 0 4px;
    }
    .buy {
      display: flex;
      flex-direction: column;
      gap: 5px;
      text-align: center;
      padding: 16px 18px;
      border-radius: 10px;
      text-decoration: none;
    }
    .buy-kind {
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      opacity: 0.75;
    }
    .buy-store { font-size: 1.05rem; font-weight: 700; line-height: 1.2; }

    .buy-primary {
      background: var(--forest);
      color: #fff !important;
      transition: transform 0.1s ease, background 0.15s ease;
    }
    .buy-primary:hover { background: var(--teal); transform: translateY(-1px); }

    /* Not on sale yet. Deliberately a <span>, not a disabled-looking
       link — there is nothing to click, and saying so plainly beats a
       button that swallows a tap. */
    .buy-soon {
      background: var(--bone);
      border: 1px dashed var(--brass);
      color: #8a8175;
      cursor: default;
    }

    .included {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid #eee;
    }
    .included-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--forest);
      margin: 0;
    }
    .included .features { margin-bottom: 0; }

    /* Gallery: same true-aspect-ratio approach as the Leia page (a
       portrait cover shot and a landscape interior spread have very
       different native shapes — force-cropping both into one box hides
       content rather than showcasing it). */
    .gallery {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .gallery figure {
      margin: 0;
      height: 240px;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(0,0,0,0.10);
    }
    .gallery figure.ph-portrait { aspect-ratio: 1082 / 1400; }
    .gallery figure.ph-square { aspect-ratio: 1 / 1; }
    .gallery img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    @media (max-width: 480px) {
      .buys { grid-template-columns: 1fr; }
      .gallery { gap: 10px; }
      .gallery figure { height: 190px; }
    }
    footer {
      text-align: center;
      margin-top: 50px;
      padding-top: 26px;
      border-top: 1px solid #eee;
      font-size: 0.9rem;
      color: #777;
    }
    footer a { color: var(--teal); text-decoration: none; font-weight: 600; }
  </style>
</body>
</html>
