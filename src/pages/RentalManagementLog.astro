---
import { REACH_FORMS } from '../data/site';
import QrLogo from '../components/QrLogo.astro';
import '../styles/qr-brand.css';
// Dedicated landing page for the "Rental Property Record Book" (LogicManse
// Publications) — a lead-magnet giveaway page for the free companion
// digital rental tracker, same funnel pattern as LeiaColoringBook.astro.
//
// THIS IS THE QR-CODE PAGE, NOT THE PRODUCT PAGE. It exists to hand the
// free bonus to somebody who already owns the book and has just scanned
// the code in the back of it. The page that SELLS the book is
// src/pages/books/rental-property-record-book.astro — keep the two separate, and never
// put a buy button here: this reader has already bought.
//
// Palette and tone deliberately differ from Leia's page: this book's own
// design brief (Rental_Property_Log_Blueprint.md, LogicManse Publications
// Book Blueprint No. 01) calls for "a different visual register from Leia
// on purpose — this is a business tool, not a children's book." Colors
// below (forest ink / bone paper / brass / ledger teal) are taken directly
// from that blueprint's §04 cover design brief, not reused from Leia.
//
// This page is self-contained (its own <head>/<body>, not the main site's
// BaseLayout/Header/Footer), same reasoning as Leia's page: a reader
// arriving from a printed QR code has one thing to do, and the site's own
// nav would only distract — see the identical note on HeartHealthLog.astro.
//
// Gallery images come straight from the finished production files: the
// cover is the front panel of Rental_Property_Record_Book_COVER.pdf
// rendered at its trim box (NOT the Book Bolt re-processed export, which
// double-pads the bleed — see the blueprint's §08 defect note), and the
// interior shot is the monthly income & expense tracker.
//
// Route: this file's name controls the URL, so it lives at
// https://www.logicmanse.ca/RentalManagementLog/
// A small static redirect file (public/RentalManagementLog.html) also
// exists so the exact URL (no trailing slash) always lands on this real
// page too, regardless of how GitHub Pages resolves that ambiguity.
const PAGE_TITLE = 'Your Free Digital Rental Tracker | LogicManse Publications';
const PAGE_DESCRIPTION =
  'Get a free digital rental tracker — the companion spreadsheet to the Rental Property Record Book, for landlords managing up to 6 properties.';
const CANONICAL_URL = 'https://www.logicmanse.ca/RentalManagementLog/';
const REACH_FORM_URL = REACH_FORMS.rentalLog;
---

<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESCRIPTION} />
  <link rel="canonical" href={CANONICAL_URL} />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESCRIPTION} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={CANONICAL_URL} />
  <!-- Brand type: Merriweather headings, Inter body — same as the site. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="wrap">
    <QrLogo />

    <p class="eyebrow">You've got the book — here's the companion</p>
    <h1>Your Free Digital Rental Tracker</h1>
    <p class="sub">
      Thanks for picking up the <em>Rental Property Record Book</em>. The companion spreadsheet
      is yours — the same sections you write by hand, totalled for you.
    </p>

    <div class="card">
      <h2>What's inside:</h2>
      <ul class="features">
        <li>A 12-month rent payment tracker, ready to use for up to 6 properties</li>
        <li>A tenant &amp; lease log with every renewal date in one place, so nothing sneaks up on you</li>
        <li>A monthly income &amp; expense tracker built with tax time in mind</li>
        <li>A vendor &amp; contractor directory template, organized by trade</li>
      </ul>

      <a class="cta" href={REACH_FORM_URL}>Send Me the Tracker →</a>
      <p class="fineprint">Takes 10 seconds. We'll email you the link right away.</p>
    </div>

    <div class="gallery">
      <figure class="ph-portrait">
        <img src="/rental-management-log/cover-front.jpg" alt="Rental Property Record Book cover" />
      </figure>
      <figure class="ph-square">
        <img
          src="/rental-management-log/interior-page.jpg"
          alt="A sample interior page: the monthly income &amp; expense tracker"
        />
      </figure>
    </div>

    <p class="hint">
      Haven't got the book yet?
      <a href="/books/rental-property-record-book/">See where to buy it →</a>
    </p>

    <footer>
      Written by @Antz · A LogicManse Publication<br>
      <a href="/">logicmanse.ca</a>
    </footer>
  </div>

  <style>
    /* Page-specific only — the brand look is in src/styles/qr-brand.css. */
    .gallery figure.ph-portrait { aspect-ratio: 1082 / 1400; }
    .gallery figure.ph-square { aspect-ratio: 1 / 1; }
  </style>
</body>
</html>
