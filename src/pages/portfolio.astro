---
// This page was the "Sample Projects" portfolio for the pre-pivot
// retail-software business (see git history if you ever need that
// content back). Kept as a redirect, not deleted outright, so old
// bookmarks/search results don't dead-end in a 404.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio" description="See our books at /books/.">
  <meta http-equiv="refresh" content="0; url=/books/" />
  <section class="bg-white">
    <div class="max-w-2xl mx-auto px-6 py-24 text-center">
      <p class="text-slate-600">
        This page has moved — redirecting you to
        <a href="/books/" class="text-forest font-semibold hover:underline">our Books page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
