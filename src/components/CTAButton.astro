---
// Reusable call-to-action button. Two visual styles: "solid" (tungsten
// amber, for primary actions) and "outline" (for secondary actions on
// dark reel backgrounds).
interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  class?: string;
}
const { href, variant = 'solid', class: className = '' } = Astro.props;

const base =
  'inline-block font-display uppercase tracking-wide px-8 py-4 rounded-sm text-center transition-colors duration-200';
const styles = {
  solid: 'bg-tungsten hover:bg-tungsten-light text-reel shadow-lg shadow-black/30',
  outline: 'border-2 border-print/40 text-print hover:border-tungsten hover:text-tungsten',
};
---

<a href={href} class={`${base} ${styles[variant]} ${className}`}>
  <slot />
</a>
