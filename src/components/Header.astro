---
// Site header / navigation bar — Reelcase brand.
// Highlights the current page automatically by comparing the URL.
import { SITE, HEADER_NAV_LINKS } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="bg-reel/95 backdrop-blur text-print sticky top-0 z-50 border-b border-white/5">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 font-display text-2xl tracking-wide uppercase">
      <svg viewBox="0 0 40 32" class="w-7 h-6" aria-hidden="true">
        <path d="M2 12 L2 30 L38 30 L38 12 Z" fill="#2A2521" />
        <path d="M1 4 L38 2 L38 12 L1 12 Z" fill="#F2A93B" />
        <path d="M6 4 L11 12 L6 12 Z M15 3.4 L20 12 L15 12 Z M24 3 L29 12 L24 12 Z" fill="#1C1815" />
      </svg>
      <span>Reel<span class="text-tungsten">case</span></span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-body font-medium">
      {HEADER_NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class={`hover:text-tungsten transition-colors ${
            currentPath === link.href ? 'text-tungsten' : 'text-print/90'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="bg-tungsten hover:bg-tungsten-light text-reel font-display uppercase tracking-wide px-4 py-2 rounded-sm transition-colors"
      >
        Get Early Access
      </a>
    </nav>

    <!-- Mobile menu toggle (pure CSS/HTML checkbox trick — zero JS needed) -->
    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="lg:hidden cursor-pointer select-none text-2xl leading-none px-2"
      aria-label="Open menu"
    >
      &#9776;
    </label>

    <nav
      class="hidden peer-checked:flex lg:hidden flex-col gap-4 absolute top-full left-0 w-full bg-reel px-6 py-6 border-t border-white/10 text-sm font-body font-medium"
    >
      {HEADER_NAV_LINKS.map((link) => (
        <a href={link.href} class="hover:text-tungsten transition-colors">
          {link.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="bg-tungsten hover:bg-tungsten-light text-reel font-display uppercase tracking-wide px-4 py-2 rounded-sm text-center transition-colors"
      >
        Get Early Access
      </a>
    </nav>
  </div>
</header>
