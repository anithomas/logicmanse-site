---
// Consistent section heading. `reelcase` switches to the Reelcase brand
// treatment (mono eyebrow, display headline, warm-dark palette); the
// legacy navy/white variant (with its `light` toggle) stays the default
// for un-migrated inner pages.
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  light?: boolean; // legacy only: true = white text, for use on navy backgrounds
  center?: boolean;
  reelcase?: boolean;
}
const { eyebrow, title, subtitle, light = false, center = true, reelcase = false } = Astro.props;
---

{reelcase ? (
  <div class={`fade-in-up ${center ? 'text-center mx-auto' : ''} max-w-3xl mb-12`}>
    {eyebrow && (
      <p class="timecode uppercase tracking-widest text-xs md:text-sm mb-3">
        {eyebrow}
      </p>
    )}
    <h2 class="font-display uppercase text-3xl md:text-5xl tracking-wide text-print mb-4">
      {title}
    </h2>
    {subtitle && (
      <p class="font-body text-lg leading-relaxed text-print/70">
        {subtitle}
      </p>
    )}
  </div>
) : (
  <div class={`fade-in-up ${center ? 'text-center mx-auto' : ''} max-w-3xl mb-12`}>
    {eyebrow && (
      <p class={`uppercase tracking-widest text-sm font-semibold mb-3 ${light ? 'text-forest-light' : 'text-forest'}`}>
        {eyebrow}
      </p>
    )}
    <h2 class={`text-3xl md:text-4xl font-bold mb-4 ${light ? 'text-white' : 'text-navy'}`}>
      {title}
    </h2>
    {subtitle && (
      <p class={`text-lg leading-relaxed ${light ? 'text-white/80' : 'text-slate-600'}`}>
        {subtitle}
      </p>
    )}
  </div>
)}
