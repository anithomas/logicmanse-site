---
// Row of social-profile icons, from SOCIAL_LINKS. Inherits the surrounding
// text colour (currentColor), so it works on the navy footer and on the
// light printed-QR pages alike.
import { SOCIAL_LINKS } from '../data/site';
import { SOCIAL_ICON_PATHS } from '../data/social-icons';

const { size = 22 } = Astro.props;
---

<ul class="social-icons">
  {SOCIAL_LINKS.map((link) => (
    <li>
      <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
        <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
          <path d={SOCIAL_ICON_PATHS[link.label]} />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social-icons { display: flex; flex-wrap: wrap; justify-content: inherit; gap: 14px; list-style: none; margin: 0; padding: 0; }
  .social-icons a { display: inline-flex; padding: 4px; color: inherit; opacity: 0.85; transition: opacity 0.15s ease, color 0.15s ease; }
  .social-icons a:hover { opacity: 1; color: #3FA877; }
</style>
