---
// Reelcase footer.
import { SITE, NAV_LINKS } from '../data/site';
---

<footer class="bg-reel-light text-print/70 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-6 py-12 grid gap-10 md:grid-cols-3">
    <div>
      <p class="flex items-center gap-2 font-display text-lg text-print uppercase tracking-wide mb-2">
        <svg viewBox="0 0 40 32" class="w-6 h-5" aria-hidden="true">
          <path d="M2 12 L2 30 L38 30 L38 12 Z" fill="#2A2521" />
          <path d="M1 4 L38 2 L38 12 L1 12 Z" fill="#F2A93B" />
          <path d="M6 4 L11 12 L6 12 Z M15 3.4 L20 12 L15 12 Z M24 3 L29 12 L24 12 Z" fill="#1C1815" />
        </svg>
        <span>Reel<span class="text-tungsten">case</span></span>
      </p>
      <p class="text-sm leading-relaxed">
        Cinematic portfolios for UGC creators — built to get a callback, not a scroll-past.
      </p>
    </div>

    <div>
      <p class="text-print font-semibold mb-2 text-sm uppercase tracking-wide font-mono">Site</p>
      <ul class="space-y-1 text-sm">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="hover:text-tungsten transition-colors">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-print font-semibold mb-2 text-sm uppercase tracking-wide font-mono">Contact</p>
      <ul class="space-y-1 text-sm">
        <li>
          <a href={`mailto:${SITE.contactEmail}`} class="hover:text-tungsten transition-colors">
            {SITE.contactEmail}
          </a>
        </li>
        <li>{SITE.location}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-6 py-6 text-xs text-print/40 font-mono">
      {SITE.businessName} &copy; {SITE.copyrightYear}. A brand of Logicmanse Solutions Canada Inc.
    </div>
  </div>
</footer>
